@page
@model RentalApp.Pages.ApartmentTenants.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Payments";
}

<div class="page-header-block">
    <h2 class="mb-0">Properties</h2>
    <button type="button" class="btn btn-primary" onclick="openAddPropertyModal()">+ Add Property</button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" class="filter-bar row g-2 align-items-end">
    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
    <input type="hidden" name="DepositsPageNumber" value="@Model.DepositsPageNumber" />
    <input type="hidden" name="ExpandedRoomId" value="@Model.ExpandedRoomId" />
    <input type="hidden" name="ExpandedDepositUnitId" value="@Model.ExpandedDepositUnitId" />
    <div class="col-md-6">
        <input asp-for="PropertySearch" class="form-control" placeholder="Search property by name or address" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<div class="card app-card card-body mb-4">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;"></th>
                    <th>Name</th>
                    <th>Address</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model.PagedProperties.Items)
                {
                    var propertyCollapseId = $"units-{property.Id}";
                    var propertyUnits = Model.UnitsByPropertyId.TryGetValue(property.Id, out var units) ? units : [];

                    <tr>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary property-toggle" data-bs-toggle="collapse" data-bs-target="#@propertyCollapseId" data-property-id="@property.Id" aria-expanded="false" aria-controls="@propertyCollapseId">View</button>
                        </td>
                        <td>@property.Name</td>
                        <td>@property.Address</td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick='openEditPropertyModal(@Html.Raw(JsonSerializer.Serialize(property)))'>Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="openAddUnitModal(@property.Id)">+ Add Unit</button>
                            </div>
                        </td>
                    </tr>

                    <tr class="collapse property-collapse" id="@propertyCollapseId">
                        <td colspan="4" class="bg-light">
                            <div class="p-2">
                                <strong class="app-section-title mb-2">Units under @property.Name</strong>
                                <div class="card app-card card-body bg-white">
                                    <div class="table-responsive">
                                        <table class="table app-grid table-sm table-bordered align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Unit</th>
                                                    <th>Monthly Rent</th>
                                                    <th>Max Capacity</th>
                                                    <th>Status</th>
                                                    <th class="text-end">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (propertyUnits.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="5" class="text-center text-muted">No units found for this property.</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var unit in propertyUnits)
                                                    {
                                                        var unitRoomsCollapseId = $"unit-rooms-{property.Id}-{unit.Id}";

                                                        <tr>
                                                            <td>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary unit-toggle" data-bs-toggle="collapse" data-bs-target="#@unitRoomsCollapseId" aria-expanded="false" aria-controls="@unitRoomsCollapseId">View Capacity</button>
                                                                <span class="ms-2">@unit.UnitNumber</span>
                                                            </td>
                                                            <td>@unit.MonthlyRent.ToString("N2")</td>
                                                            <td>@(unit.IsActive ? unit.Status.ToString() : "Inactive")</td>
                                                            <td class="text-end">
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick='openEditUnitModal(@Html.Raw(JsonSerializer.Serialize(unit)))'>Edit</button>
                                                            </td>
                                                        </tr>

                                                        <tr class="collapse unit-collapse" id="@unitRoomsCollapseId">
                                                            <td colspan="4" class="bg-white">
                                                                <div class="px-2 py-1">
                                                                    <p class="text-muted mb-0">No room capacity tracking for this unit.</p>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/ApartmentTenants/Index",
    PageParameterName = "PropertiesPageNumber",
    PageNumber = Model.PagedProperties.PageNumber,
    TotalPages = Model.PagedProperties.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["PropertySearch"] = Model.PropertySearch ?? string.Empty,
        ["PageNumber"] = Model.PageNumber.ToString(),
        ["DepositsPageNumber"] = Model.DepositsPageNumber.ToString(),
        ["ExpandedRoomId"] = Model.ExpandedRoomId?.ToString() ?? string.Empty
    }
})" />

<div class="page-header-block mt-4">
    <h2 class="mb-0">Payments</h2>
</div>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;"></th>
                    <th>Unit</th>
                    <th>Monthly Rent</th>
                    <th>Due Date</th>
                    <th>No. of Tenants</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PagedPaymentRows.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No units found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.PagedPaymentRows.Items)
                    {
                        var collapseId = $"payments-room-{row.RoomId}";
                        var history = Model.PaymentHistoryByRoomId.TryGetValue(row.RoomId, out var roomPayments) ? roomPayments : [];

                        <tr>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-secondary room-payments-toggle" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(Model.ExpandedRoomId == row.RoomId ? "true" : "false")" aria-controls="@collapseId">View</button>
                            </td>
                            <td>
                                <div>@row.UnitRoomLabel</div>
                                <div class="text-muted small">@row.PropertyName</div>
                            </td>
                            <td>@row.MonthlyRent.ToString("N2")</td>
                            <td>@(row.DueDate?.ToString("MMM-dd-yyyy") ?? "-")</td>
                            <td>@row.TenantCountDisplay</td>
                            <td>@row.Status</td>
                        </tr>

                        <tr class="collapse @(Model.ExpandedRoomId == row.RoomId ? "show" : null)" id="@collapseId" data-room-id="@row.RoomId">
                            <td colspan="6" class="bg-light">
                                <div class="p-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                                        <strong class="app-section-title mb-0">Payment History - @row.UnitRoomLabel</strong>
                                        @if (row.CanAddPayment && row.LeaseId.HasValue)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary open-add-payment-modal"
                                                    data-room-id="@row.RoomId"
                                                    data-lease-id="@row.LeaseId"
                                                    data-amount="@row.DefaultAmount"
                                                    data-unit-room="@row.UnitRoomLabel"
                                                    data-due-date="@(row.DueDate?.ToString("yyyy-MM-dd") ?? string.Empty)">
                                                Add Payment
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>No unpaid due</button>
                                        }
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Due Date</th>
                                                    <th>Date Paid</th>
                                                    <th>Amount</th>
                                                    <th>Method</th>
                                                    <th>Reference</th>
                                                    <th>Notes</th>
                                                    <th style="width: 120px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (history.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="7" class="text-center text-muted">No payment history yet.</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var payment in history)
                                                    {
                                                        <tr>
                                                            <td>@payment.DueDate.ToString("MMM-dd-yyyy")</td>
                                                            <td>@payment.PaymentDate.ToString("MMM-dd-yyyy")</td>
                                                            <td>@payment.Amount.ToString("N2")</td>
                                                            <td>@payment.PaymentMethod</td>
                                                            <td>@(string.IsNullOrWhiteSpace(payment.ReferenceNumber) ? "-" : payment.ReferenceNumber)</td>
                                                            <td>@(string.IsNullOrWhiteSpace(payment.Notes) ? "-" : payment.Notes)</td>
                                                            <td>
                                                                <button type="button"
                                                                        class="btn btn-sm btn-outline-warning open-edit-payment-modal"
                                                                        data-payment-id="@payment.Id"
                                                                        data-room-id="@row.RoomId"
                                                                        data-amount="@payment.Amount"
                                                                        data-payment-date="@payment.PaymentDate.ToString("yyyy-MM-dd")"
                                                                        data-payment-method="@payment.PaymentMethod"
                                                                        data-reference="@payment.ReferenceNumber"
                                                                        data-notes="@payment.Notes">
                                                                    Edit
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/ApartmentTenants/Index",
    PageNumber = Model.PagedPaymentRows.PageNumber,
    TotalPages = Model.PagedPaymentRows.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["PropertySearch"] = Model.PropertySearch ?? string.Empty,
        ["PropertiesPageNumber"] = Model.PropertiesPageNumber.ToString(),
        ["DepositsPageNumber"] = Model.DepositsPageNumber.ToString(),
        ["ExpandedRoomId"] = Model.ExpandedRoomId?.ToString() ?? string.Empty
    }
})" />

<div class="modal fade" id="propertyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="propertyForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="propertyModalTitle">Property</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="propertyId" />
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" id="propertyName" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input class="form-control" id="propertyAddress" required maxlength="500" />
                    </div>
                    <div class="alert alert-danger d-none" id="propertyModalError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="unitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="unitForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="unitModalTitle">Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="unitId" />
                    <input type="hidden" id="unitPropertyId" />
                    <div class="mb-3">
                        <label class="form-label">Unit Number</label>
                        <input class="form-control" id="unitNumber" required maxlength="50" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Monthly Rent</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="unitMonthlyRent" required />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Room Count</label>
                            <input type="number" min="1" max="500" class="form-control" id="unitRoomCount" required />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Max Capacity</label>
                            <input type="number" min="1" class="form-control" id="unitRoomMaxCapacity" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="unitStatus">
                            <option value="1">Available</option>
                            <option value="2">Occupied</option>
                            <option value="3">Maintenance</option>
                            <option value="4">Inactive</option>
                        </select>
                    </div>
                    <div class="alert alert-danger d-none" id="unitModalError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="addPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddPayment" id="addPaymentForm">
                <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-2"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Add Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="AddPaymentInput.RoomId" id="addPaymentRoomId" />
                    <input type="hidden" asp-for="AddPaymentInput.LeaseId" id="addPaymentLeaseId" />

                    <div class="mb-2">
                        <label class="form-label">Unit</label>
                        <input type="text" class="form-control" id="addPaymentUnitRoomLabel" readonly />
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddPaymentInput.Amount" class="form-label"></label>
                        <input asp-for="AddPaymentInput.Amount" class="form-control" id="addPaymentAmountInput" />
                        <span asp-validation-for="AddPaymentInput.Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Due Date</label>
                        <input type="text" class="form-control" id="addPaymentDueDate" readonly />
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddPaymentInput.PaymentDate" class="form-label"></label>
                        <input asp-for="AddPaymentInput.PaymentDate" class="form-control" type="date" id="addPaymentDateInput" />
                        <span asp-validation-for="AddPaymentInput.PaymentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddPaymentInput.PaymentMethod" class="form-label"></label>
                        <select asp-for="AddPaymentInput.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select" id="addPaymentMethodInput"></select>
                        <span asp-validation-for="AddPaymentInput.PaymentMethod" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="page-header-block mt-4">
    <h2 class="mb-0">Deposits</h2>
</div>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>Deposit</th>
                    <th>Date Paid</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PagedDepositRows.Items.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No deposits found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.PagedDepositRows.Items)
                    {
                        var depositCollapseId = $"deposits-unit-{row.UnitId}";
                        var unitDepositHistory = Model.DepositHistoryByUnitId.TryGetValue(row.UnitId, out var deposits) ? deposits : [];

                        <tr>
                            <td>
                                <div>@row.UnitLabel</div>
                                <div class="text-muted small">@row.PropertyName</div>
                            </td>
                            <td>@(row.DepositAmount.HasValue ? row.DepositAmount.Value.ToString("N2") : "-")</td>
                            <td>@(row.DatePaid?.ToString("MMM-dd-yyyy") ?? "-")</td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    @if (row.DepositCount > 1)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary deposit-history-toggle"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@depositCollapseId"
                                                aria-expanded="@(Model.ExpandedDepositUnitId == row.UnitId ? "true" : "false")"
                                                aria-controls="@depositCollapseId">
                                            View Deposits
                                        </button>
                                    }

                                    @if (row.CanAddDeposit && row.LeaseId.HasValue)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-primary open-add-deposit-modal"
                                                data-unit-id="@row.UnitId"
                                                data-lease-id="@row.LeaseId"
                                                data-unit-label="@row.UnitLabel"
                                                data-property-name="@row.PropertyName"
                                                data-amount="0">
                                            Add Deposit
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>No active lease</button>
                                    }
                                </div>
                            </td>
                        </tr>

                        <tr class="collapse @(Model.ExpandedDepositUnitId == row.UnitId ? "show" : null)" id="@depositCollapseId" data-deposit-unit-id="@row.UnitId">
                            <td colspan="4" class="bg-light">
                                <div class="p-2">
                                    <strong class="app-section-title mb-2">Deposit History - @row.UnitLabel</strong>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Date Paid</th>
                                                    <th>Deposit</th>
                                                    <th>Method</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (unitDepositHistory.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">No deposit history yet.</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var deposit in unitDepositHistory)
                                                    {
                                                        <tr>
                                                            <td>@deposit.PaymentDate.ToString("MMM-dd-yyyy")</td>
                                                            <td>@deposit.Amount.ToString("N2")</td>
                                                            <td>@deposit.PaymentMethod</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/ApartmentTenants/Index",
    PageParameterName = "DepositsPageNumber",
    PageNumber = Model.PagedDepositRows.PageNumber,
    TotalPages = Model.PagedDepositRows.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["PropertySearch"] = Model.PropertySearch ?? string.Empty,
