@page
@model RentalApp.Pages.ApartmentTenants.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Apartment Tenants";
}

<div class="page-header-block">
    <h2 class="mb-0">Properties</h2>
    <button type="button" class="btn btn-primary" onclick="openAddPropertyModal()">+ Add Property</button>
</div>

<form method="get" class="filter-bar row g-2 align-items-end">
    <input type="hidden" name="Search" value="@Model.Search" />
    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
    <input type="hidden" name="ExpandedTenantId" value="@Model.ExpandedTenantId" />
    <div class="col-md-6">
        <input asp-for="PropertySearch" class="form-control" placeholder="Search property by name or address" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<div class="card app-card card-body mb-4">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;"></th>
                    <th>Name</th>
                    <th>Address</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model.PagedProperties.Items)
                {
                    var propertyCollapseId = $"units-{property.Id}";
                    var propertyUnits = Model.UnitsByPropertyId.TryGetValue(property.Id, out var units) ? units : [];

                    <tr>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary property-toggle" data-bs-toggle="collapse" data-bs-target="#@propertyCollapseId" data-property-id="@property.Id" aria-expanded="false" aria-controls="@propertyCollapseId">View</button>
                        </td>
                        <td>@property.Name</td>
                        <td>@property.Address</td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick='openEditPropertyModal(@Html.Raw(JsonSerializer.Serialize(property)))'>Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="openAddUnitModal(@property.Id)">+ Add Unit</button>
                            </div>
                        </td>
                    </tr>

                    <tr class="collapse property-collapse" id="@propertyCollapseId">
                        <td colspan="4" class="bg-light">
                            <div class="p-2">
                                <strong class="app-section-title mb-2">Units under @property.Name</strong>
                                <div class="card app-card card-body bg-white">
                                    <div class="table-responsive">
                                        <table class="table app-grid table-sm table-bordered align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Unit</th>
                                                    <th>Monthly Rent</th>
                                                    <th>Rooms</th>
                                                    <th>Max Capacity</th>
                                                    <th>Status</th>
                                                    <th class="text-end">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (propertyUnits.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="6" class="text-center text-muted">No units found for this property.</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var unit in propertyUnits)
                                                    {
                                                        var unitRoomsCollapseId = $"unit-rooms-{property.Id}-{unit.Id}";

                                                        <tr>
                                                            <td>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary unit-toggle" data-bs-toggle="collapse" data-bs-target="#@unitRoomsCollapseId" aria-expanded="false" aria-controls="@unitRoomsCollapseId">View Rooms</button>
                                                                <span class="ms-2">@unit.UnitNumber</span>
                                                            </td>
                                                            <td>@unit.MonthlyRent.ToString("N2")</td>
                                                            <td>@unit.RoomCount</td>
                                                            <td>@unit.RoomMaxCapacity</td>
                                                            <td>@(unit.IsActive ? unit.Status.ToString() : "Inactive")</td>
                                                            <td class="text-end">
                                                                <div class="btn-group" role="group">
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick='openEditUnitModal(@Html.Raw(JsonSerializer.Serialize(unit)))'>Edit</button>
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        <tr class="collapse unit-collapse" id="@unitRoomsCollapseId">
                                                            <td colspan="6" class="bg-white">
                                                                <div class="px-2 py-1">
                                                                    <strong class="app-section-title mb-2">@unit.UnitNumber Room Status</strong>
                                                                    <div class="card app-card card-body bg-light">
                                                                        <div class="table-responsive">
                                                                            <table class="table app-grid table-sm table-bordered align-middle mb-0">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th>Room</th>
                                                                                        <th>Occupied</th>
                                                                                        <th>Capacity</th>
                                                                                        <th>Status</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @if (unit.RoomStatuses.Count == 0)
                                                                                    {
                                                                                        <tr>
                                                                                            <td colspan="4" class="text-center text-muted">No active rooms for this unit.</td>
                                                                                        </tr>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        @foreach (var room in unit.RoomStatuses)
                                                                                        {
                                                                                            <tr>
                                                                                                <td>@room.RoomNumber</td>
                                                                                                <td>@room.OccupiedCount</td>
                                                                                                <td>@room.MaxCapacity</td>
                                                                                                <td>@room.Status</td>
                                                                                            </tr>
                                                                                        }
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/ApartmentTenants/Index",
    PageParameterName = "PropertiesPageNumber",
    PageNumber = Model.PagedProperties.PageNumber,
    TotalPages = Model.PagedProperties.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["PropertySearch"] = Model.PropertySearch ?? string.Empty,
        ["Search"] = Model.Search ?? string.Empty,
        ["PageNumber"] = Model.PageNumber.ToString(),
        ["ExpandedTenantId"] = Model.ExpandedTenantId?.ToString() ?? string.Empty
    }
})" />

<div class="page-header-block mt-4">
    <h2 class="mb-0">Apartment Tenants</h2>
    <button type="button" class="btn btn-primary" id="openAddTenantModalBtn">Add Tenant</button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" class="filter-bar row g-2 align-items-end">
    <input type="hidden" name="PropertySearch" value="@Model.PropertySearch" />
    <input type="hidden" name="PropertiesPageNumber" value="@Model.PropertiesPageNumber" />
    <input type="hidden" name="ExpandedTenantId" value="@Model.ExpandedTenantId" />
    <div class="col-md-6">
        <input asp-for="Search" class="form-control" placeholder="Search tenant by name, contact, or email" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Apartment</th>
                <th>Tenant Name</th>
                <th>Security Deposit</th>
                <th>Contact Number</th>
                <th style="width: 90px;" class="text-end">Payments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tenant in Model.PagedTenants.Items)
            {
                var collapseId = $"history-{tenant.Id}";
                var activeApartment = Model.ActiveApartmentByTenantId.TryGetValue(tenant.Id, out var apartment) ? apartment : null;
                var history = Model.PaymentHistoryByTenantId.TryGetValue(tenant.Id, out var payments) ? payments : [];

                <tr>
                    <td>
                        @if (activeApartment is null)
                        {
                            <span class="text-muted">No active apartment</span>
                        }
                        else
                        {
                            <span>@activeApartment.UnitNumber / @activeApartment.RoomNumber</span>
                        }
                    </td>
                    <td>@tenant.FirstName @tenant.LastName</td>
                    <td>
                        @if (activeApartment is null)
                        {
                            <span class="text-muted">N/A</span>
                        }
                        else
                        {
                            @activeApartment.SecurityDeposit.ToString("N2")
                        }
                    </td>
                    <td>@tenant.ContactNumber</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary tenant-payments-toggle" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(Model.ExpandedTenantId == tenant.Id ? "true" : "false")" aria-controls="@collapseId">Payments</button>
                    </td>
                </tr>

                <tr class="collapse @(Model.ExpandedTenantId == tenant.Id ? "show" : null)" id="@collapseId" data-tenant-id="@tenant.Id">
                    <td colspan="5" class="bg-light">
                        <div class="p-2">
                            <strong class="d-block mb-2">Payment Transaction History</strong>

                            @{
                                var unpaidItems = Model.UnpaidLeasesByTenantId.TryGetValue(tenant.Id, out var unpaidLeases) ? unpaidLeases : [];
                            }

                            <div class="card app-card card-body mb-3 bg-white">
                                <strong class="app-section-title mb-2">Paid History</strong>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date Paid</th>
                                                <th>Amount Paid</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (history.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-center text-muted">No payment transactions yet.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var payment in history)
                                                {
                                                    <tr>
                                                        <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                                        <td>@payment.Amount.ToString("N2")</td>
                                                        <td>@payment.PaymentStatus</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="card app-card card-body bg-white">
                                <strong class="app-section-title mb-2">Unpaid Amounts</strong>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Apartment</th>
                                                <th>Rent</th>
                                                <th>Paid</th>
                                                <th>Unpaid</th>
                                                <th style="width: 130px;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (unpaidItems.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted">No unpaid amounts.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var unpaid in unpaidItems)
                                                {
                                                    <tr>
                                                        <td>@unpaid.ApartmentLabel</td>
                                                        <td>@unpaid.MonthlyRent.ToString("N2")</td>
                                                        <td>@unpaid.PaidAmount.ToString("N2")</td>
                                                        <td>@unpaid.UnpaidAmount.ToString("N2")</td>
                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-primary open-tenant-payment-modal"
                                                                    data-tenant-id="@tenant.Id"
                                                                    data-lease-id="@unpaid.LeaseId"
                                                                    data-amount="@unpaid.UnpaidAmount"
                                                                    data-apartment="@unpaid.ApartmentLabel">
                                                                Add Payment
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/ApartmentTenants/Index",
    PageNumber = Model.PagedTenants.PageNumber,
    TotalPages = Model.PagedTenants.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["Search"] = Model.Search ?? string.Empty,
        ["PropertySearch"] = Model.PropertySearch ?? string.Empty,
        ["PropertiesPageNumber"] = Model.PropertiesPageNumber.ToString(),
        ["ExpandedTenantId"] = Model.ExpandedTenantId?.ToString() ?? string.Empty
    }
})" />

<div class="modal fade" id="propertyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="propertyForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="propertyModalTitle">Property</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="propertyId" />
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" id="propertyName" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input class="form-control" id="propertyAddress" required maxlength="500" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="propertyDescription" rows="3" maxlength="1000"></textarea>
                    </div>
                    <div class="alert alert-danger d-none" id="propertyModalError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="unitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="unitForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="unitModalTitle">Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="unitId" />
                    <input type="hidden" id="unitPropertyId" />
                    <div class="mb-3">
                        <label class="form-label">Unit Number</label>
                        <input class="form-control" id="unitNumber" required maxlength="50" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Monthly Rent</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="unitMonthlyRent" required />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Room Count</label>
                            <input type="number" min="1" max="500" class="form-control" id="unitRoomCount" required />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Max Capacity</label>
                            <input type="number" min="1" max="3" class="form-control" id="unitRoomMaxCapacity" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="unitStatus">
                            <option value="1">Available</option>
                            <option value="2">Occupied</option>
                            <option value="3">Maintenance</option>
                            <option value="4">Inactive</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="unitDescription" rows="3" maxlength="1000"></textarea>
                    </div>
                    <div class="alert alert-danger d-none" id="unitModalError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="addTenantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddTenantApartment">
                <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-2"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Add Tenant</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6 class="mb-2">Tenant Information</h6>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label asp-for="TenantInput.FirstName" class="form-label"></label>
                            <input asp-for="TenantInput.FirstName" class="form-control" />
                            <span asp-validation-for="TenantInput.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label asp-for="TenantInput.LastName" class="form-label"></label>
                            <input asp-for="TenantInput.LastName" class="form-control" />
                            <span asp-validation-for="TenantInput.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label asp-for="TenantInput.ContactNumber" class="form-label"></label>
                            <input asp-for="TenantInput.ContactNumber" class="form-control" />
                            <span asp-validation-for="TenantInput.ContactNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label asp-for="TenantInput.Email" class="form-label"></label>
                            <input asp-for="TenantInput.Email" class="form-control" />
                            <span asp-validation-for="TenantInput.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label asp-for="TenantInput.Address" class="form-label"></label>
                        <input asp-for="TenantInput.Address" class="form-control" />
                        <span asp-validation-for="TenantInput.Address" class="text-danger"></span>
                    </div>

                    <hr />
                    <h6 class="mb-2">Apartment Information</h6>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label asp-for="ApartmentInput.UnitId" class="form-label"></label>
                            <select asp-for="ApartmentInput.UnitId" asp-items="Model.UnitOptions" class="form-select" id="tenantApartmentUnitSelect"></select>
                            <span asp-validation-for="ApartmentInput.UnitId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label asp-for="ApartmentInput.RoomId" class="form-label"></label>
                            <select asp-for="ApartmentInput.RoomId" asp-items="Model.TenantApartmentRoomOptions" class="form-select" id="tenantApartmentRoomSelect"></select>
                            <span asp-validation-for="ApartmentInput.RoomId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label asp-for="ApartmentInput.MonthlyRent" class="form-label"></label>
                            <input asp-for="ApartmentInput.MonthlyRent" class="form-control" id="tenantApartmentMonthlyRent" />
                            <span asp-validation-for="ApartmentInput.MonthlyRent" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label asp-for="ApartmentInput.StartDate" class="form-label"></label>
                            <input asp-for="ApartmentInput.StartDate" class="form-control" />
                            <span asp-validation-for="ApartmentInput.StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label asp-for="ApartmentInput.DueDayOfMonth" class="form-label"></label>
                            <input asp-for="ApartmentInput.DueDayOfMonth" class="form-control" />
                            <span asp-validation-for="ApartmentInput.DueDayOfMonth" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label asp-for="ApartmentInput.SecurityDeposit" class="form-label"></label>
                        <input asp-for="ApartmentInput.SecurityDeposit" class="form-control" />
                        <span asp-validation-for="ApartmentInput.SecurityDeposit" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="ApartmentInput.Notes" class="form-label"></label>
                        <textarea asp-for="ApartmentInput.Notes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="ApartmentInput.Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="addTenantPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddTenantPayment">
                <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-2"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Add Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="AddTenantPaymentInput.TenantId" id="paymentTenantId" />
                    <input type="hidden" asp-for="AddTenantPaymentInput.LeaseId" id="paymentLeaseId" />

                    <div class="mb-2">
                        <label class="form-label">Apartment</label>
                        <input type="text" class="form-control" id="paymentApartmentLabel" readonly />
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddTenantPaymentInput.Amount" class="form-label"></label>
                        <input asp-for="AddTenantPaymentInput.Amount" class="form-control" id="paymentAmountInput" />
                        <span asp-validation-for="AddTenantPaymentInput.Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddTenantPaymentInput.PaymentDate" class="form-label"></label>
                        <input asp-for="AddTenantPaymentInput.PaymentDate" class="form-control" type="date" id="paymentDateInput" />
                        <span asp-validation-for="AddTenantPaymentInput.PaymentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddTenantPaymentInput.PaymentMethod" class="form-label"></label>
                        <select asp-for="AddTenantPaymentInput.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select" id="paymentMethodInput"></select>
                        <span asp-validation-for="AddTenantPaymentInput.PaymentMethod" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddTenantPaymentInput.ReferenceNumber" class="form-label"></label>
                        <input asp-for="AddTenantPaymentInput.ReferenceNumber" class="form-control" id="paymentReferenceInput" />
                        <span asp-validation-for="AddTenantPaymentInput.ReferenceNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddTenantPaymentInput.Notes" class="form-label"></label>
                        <textarea asp-for="AddTenantPaymentInput.Notes" class="form-control" rows="2" id="paymentNotesInput"></textarea>
                        <span asp-validation-for="AddTenantPaymentInput.Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const propertyModal = new bootstrap.Modal(document.getElementById('propertyModal'));
        const unitModal = new bootstrap.Modal(document.getElementById('unitModal'));

        const addTenantModalElement = document.getElementById('addTenantModal');
        const addTenantModal = addTenantModalElement ? new bootstrap.Modal(addTenantModalElement) : null;

        const addTenantPaymentModalElement = document.getElementById('addTenantPaymentModal');
        const addTenantPaymentModal = addTenantPaymentModalElement ? new bootstrap.Modal(addTenantPaymentModalElement) : null;

        document.getElementById('openAddTenantModalBtn')?.addEventListener('click', function () {
            addTenantModal?.show();
        });

        if (@Model.ShowAddTenantModal.ToString().ToLowerInvariant()) {
            addTenantModal?.show();
        }

        if (@Model.ShowAddTenantPaymentModal.ToString().ToLowerInvariant()) {
            addTenantPaymentModal?.show();
        }

        async function loadUnitInfo(unitId, roomSelectId, rentInputId) {
            if (!unitId) {
                document.getElementById(roomSelectId).innerHTML = '';
                return;
            }

            const response = await fetch(`/api/leases/unit-info/${unitId}`);
            if (!response.ok) return;

            const data = await response.json();
            const roomSelect = document.getElementById(roomSelectId);
            const rentInput = document.getElementById(rentInputId);

            if (rentInput) {
                rentInput.value = Number(data.monthlyRent ?? 0).toFixed(2);
            }

            roomSelect.innerHTML = '';
            (data.rooms || []).forEach(r => {
                if (r.availableSlots > 0) {
                    const opt = document.createElement('option');
                    opt.value = r.roomId;
                    opt.text = `${r.roomNumber} (${r.occupiedCount}/${r.maxCapacity})`;
                    roomSelect.add(opt);
                }
            });
        }

        document.getElementById('tenantApartmentUnitSelect')?.addEventListener('change', function () {
            loadUnitInfo(this.value, 'tenantApartmentRoomSelect', 'tenantApartmentMonthlyRent');
        });

        const propertyCollapseRows = Array.from(document.querySelectorAll('tr.property-collapse'));
        const unitCollapseRows = Array.from(document.querySelectorAll('tr.unit-collapse'));
        const propertiesOpenStorageKey = 'apartmentTenants:lastOpenPropertyId';

        function closeOtherRows(rows, currentTargetSelector) {
            rows.forEach(row => {
                const selector = `#${row.id}`;
                if (selector !== currentTargetSelector && row.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(row, { toggle: false }).hide();
                }
            });
        }

        document.querySelectorAll('.property-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;

                const propertyId = this.getAttribute('data-property-id') || '';
                const targetRow = document.querySelector(targetSelector);
                if (targetRow && !targetRow.classList.contains('show')) {
                    sessionStorage.setItem(propertiesOpenStorageKey, propertyId);
                } else {
                    sessionStorage.removeItem(propertiesOpenStorageKey);
                }

                closeOtherRows(propertyCollapseRows, targetSelector);
            });
        });

        document.querySelectorAll('.unit-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;
                closeOtherRows(unitCollapseRows, targetSelector);
            });
        });

        function showError(elementId, message) {
            const el = document.getElementById(elementId);
            el.textContent = message;
            el.classList.remove('d-none');
        }

        function clearError(elementId) {
            const el = document.getElementById(elementId);
            el.textContent = '';
            el.classList.add('d-none');
        }

        window.openAddPropertyModal = function () {
            clearError('propertyModalError');
            document.getElementById('propertyModalTitle').textContent = 'Add Property';
            document.getElementById('propertyId').value = '';
            document.getElementById('propertyName').value = '';
            document.getElementById('propertyAddress').value = '';
            document.getElementById('propertyDescription').value = '';
            propertyModal.show();
        }

        window.openEditPropertyModal = function (property) {
            clearError('propertyModalError');
            document.getElementById('propertyModalTitle').textContent = 'Edit Property';
            document.getElementById('propertyId').value = property.Id;
            document.getElementById('propertyName').value = property.Name ?? '';
            document.getElementById('propertyAddress').value = property.Address ?? '';
            document.getElementById('propertyDescription').value = property.Description ?? '';
            propertyModal.show();
        }

        window.openAddUnitModal = function (propertyId) {
            clearError('unitModalError');
            sessionStorage.setItem(propertiesOpenStorageKey, String(propertyId));
            document.getElementById('unitModalTitle').textContent = 'Add Unit';
            document.getElementById('unitId').value = '';
            document.getElementById('unitPropertyId').value = propertyId;
            document.getElementById('unitNumber').value = '';
            document.getElementById('unitMonthlyRent').value = '';
            document.getElementById('unitRoomCount').value = '1';
            document.getElementById('unitRoomMaxCapacity').value = '3';
            document.getElementById('unitStatus').value = '1';
            document.getElementById('unitDescription').value = '';
            unitModal.show();
        }

        window.openEditUnitModal = function (unit) {
            clearError('unitModalError');
            document.getElementById('unitModalTitle').textContent = 'Edit Unit';
            document.getElementById('unitId').value = unit.Id;
            document.getElementById('unitPropertyId').value = unit.PropertyId;
            document.getElementById('unitNumber').value = unit.UnitNumber ?? '';
            document.getElementById('unitMonthlyRent').value = unit.MonthlyRent ?? 0;
            document.getElementById('unitRoomCount').value = unit.RoomCount ?? 1;
            document.getElementById('unitRoomMaxCapacity').value = unit.RoomMaxCapacity ?? 3;
            const statusMap = { 'Available': '1', 'Occupied': '2', 'Maintenance': '3', 'Inactive': '4' };
            document.getElementById('unitStatus').value = statusMap[unit.Status] ?? '1';
            document.getElementById('unitDescription').value = unit.Description ?? '';
            unitModal.show();
        }

        const lastOpenPropertyId = sessionStorage.getItem(propertiesOpenStorageKey);
        if (lastOpenPropertyId) {
            const propertyToggleButton = document.querySelector(`.property-toggle[data-property-id='${lastOpenPropertyId}']`);
            const targetSelector = propertyToggleButton?.getAttribute('data-bs-target');
            if (propertyToggleButton && targetSelector) {
                closeOtherRows(propertyCollapseRows, targetSelector);
                const targetRow = document.querySelector(targetSelector);
                if (targetRow && !targetRow.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(targetRow, { toggle: false }).show();
                }
            }
        }

        document.getElementById('propertyForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearError('propertyModalError');

            const id = document.getElementById('propertyId').value;
            const payload = {
                name: document.getElementById('propertyName').value,
                address: document.getElementById('propertyAddress').value,
                description: document.getElementById('propertyDescription').value
            };

            const response = await fetch(id ? `/api/properties/${id}` : '/api/properties', {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const text = await response.text();
                showError('propertyModalError', text || 'Failed to save property.');
                return;
            }

            location.reload();
        });

        document.getElementById('unitForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearError('unitModalError');

            const id = document.getElementById('unitId').value;
            const selectedPropertyId = document.getElementById('unitPropertyId').value;
            if (selectedPropertyId) {
                sessionStorage.setItem(propertiesOpenStorageKey, selectedPropertyId);
            }
            const payload = {
                propertyId: Number(document.getElementById('unitPropertyId').value),
                unitNumber: document.getElementById('unitNumber').value,
                monthlyRent: Number(document.getElementById('unitMonthlyRent').value),
                roomCount: Number(document.getElementById('unitRoomCount').value),
                roomMaxCapacity: Number(document.getElementById('unitRoomMaxCapacity').value),
                status: Number(document.getElementById('unitStatus').value),
                description: document.getElementById('unitDescription').value
            };

            const response = await fetch(id ? `/api/units/${id}` : '/api/units', {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const text = await response.text();
                showError('unitModalError', text || 'Failed to save unit.');
                return;
            }

            location.reload();
        });

        const paymentTenantIdInput = document.getElementById('paymentTenantId');
        const paymentLeaseIdInput = document.getElementById('paymentLeaseId');
        const paymentAmountInput = document.getElementById('paymentAmountInput');
        const paymentApartmentLabelInput = document.getElementById('paymentApartmentLabel');

        document.querySelectorAll('.open-tenant-payment-modal').forEach(button => {
            button.addEventListener('click', function () {
                const tenantId = this.dataset.tenantId || '';
                const leaseId = this.dataset.leaseId || '';
                const amount = this.dataset.amount || '';
                const apartment = this.dataset.apartment || '';

                if (paymentTenantIdInput) paymentTenantIdInput.value = tenantId;
                if (paymentLeaseIdInput) paymentLeaseIdInput.value = leaseId;
                if (paymentAmountInput) paymentAmountInput.value = Number(amount).toFixed(2);
                if (paymentApartmentLabelInput) paymentApartmentLabelInput.value = apartment;

                addTenantPaymentModal?.show();
            });
        });

        if (@Model.ShowAddTenantPaymentModal.ToString().ToLowerInvariant()) {
            if (paymentTenantIdInput) paymentTenantIdInput.value = '@Model.PaymentModalTenantId';
            if (paymentLeaseIdInput) paymentLeaseIdInput.value = '@Model.PaymentModalLeaseId';
        }

        const paymentHistoryRows = Array.from(document.querySelectorAll('tr.collapse[data-tenant-id]'));

        function closeOtherPaymentHistories(currentTargetSelector) {
            paymentHistoryRows.forEach(row => {
                const selector = `#${row.id}`;
                if (selector !== currentTargetSelector && row.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(row, { toggle: false }).hide();
                }
            });
        }

        document.querySelectorAll('.tenant-payments-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;
                closeOtherPaymentHistories(targetSelector);
            });
        });

        const expandedTenantId = '@(Model.ExpandedTenantId?.ToString() ?? string.Empty)';
        if (expandedTenantId) {
            const row = document.querySelector(`tr.collapse[data-tenant-id='${expandedTenantId}']`);
            if (row && !row.classList.contains('show')) {
                closeOtherPaymentHistories(`#${row.id}`);
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(row, { toggle: false });
                bsCollapse.show();
            }
        }
    </script>
}
