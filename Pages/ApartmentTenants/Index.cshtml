@page
@model RentalApp.Pages.ApartmentTenants.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Payments";
}

<div class="page-header-block">
    <h2 class="mb-0">Properties</h2>
    <button type="button" class="btn btn-primary" onclick="openAddPropertyModal()">+ Add Property</button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" class="filter-bar row g-2 align-items-end">
    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
    <input type="hidden" name="DepositsPageNumber" value="@Model.DepositsPageNumber" />
    <input type="hidden" name="ExpandedRoomId" value="@Model.ExpandedRoomId" />
    <input type="hidden" name="ExpandedDepositUnitId" value="@Model.ExpandedDepositUnitId" />
    <div class="col-md-6">
        <input asp-for="PropertySearch" class="form-control" placeholder="Search property by name or address" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<div class="card app-card card-body mb-4">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;"></th>
                    <th>Name</th>
                    <th>Address</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model.PagedProperties.Items)
                {
                    var propertyCollapseId = $"units-{property.Id}";
                    var propertyUnits = Model.UnitsByPropertyId.TryGetValue(property.Id, out var units) ? units : [];

                    <tr>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary property-toggle" data-bs-toggle="collapse" data-bs-target="#@propertyCollapseId" data-property-id="@property.Id" aria-expanded="false" aria-controls="@propertyCollapseId">View</button>
                        </td>
                        <td>@property.Name</td>
                        <td>@property.Address</td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick='openEditPropertyModal(@Html.Raw(JsonSerializer.Serialize(property)))'>Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="openAddUnitModal(@property.Id)">+ Add Unit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Property" onclick="hardDeleteProperty(@property.Id)">X</button>
                            </div>
                        </td>
                    </tr>

                    <tr class="collapse property-collapse" id="@propertyCollapseId">
                        <td colspan="4" class="bg-light">
                            <div class="p-2">
                                <strong class="app-section-title mb-2">Units under @property.Name</strong>
                                <div class="card app-card card-body bg-white">
                                    <div class="table-responsive">
                                        <table class="table app-grid table-sm table-bordered align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Unit</th>
                                                    <th>Monthly Rent</th>
                                                    <th>Status</th>
                                                    <th class="text-end">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (propertyUnits.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-center text-muted">No units found for this property.</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var unit in propertyUnits)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span>@unit.UnitNumber</span>
                                                            </td>
                                                            <td>@unit.MonthlyRent.ToString("N2")</td>
                                                            <td>@(unit.IsActive ? unit.Status.ToString() : "Inactive")</td>
                                                            <td class="text-end">
                                                                <div class="btn-group" role="group">
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick='openEditUnitModal(@Html.Raw(JsonSerializer.Serialize(unit)))'>Edit</button>
                                                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Unit" onclick="hardDeleteUnit(@unit.Id)">X</button>
                                                                </div>
                                                            </td>
                                                        </tr>

                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/ApartmentTenants/Index",
    PageParameterName = "PropertiesPageNumber",
    PageNumber = Model.PagedProperties.PageNumber,
    TotalPages = Model.PagedProperties.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["PropertySearch"] = Model.PropertySearch ?? string.Empty,
        ["PageNumber"] = Model.PageNumber.ToString(),
        ["DepositsPageNumber"] = Model.DepositsPageNumber.ToString(),
        ["ExpandedRoomId"] = Model.ExpandedRoomId?.ToString() ?? string.Empty
    }
})" />

<div class="page-header-block mt-4">
    <h2 class="mb-0">Payments</h2>
</div>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;"></th>
                    <th>Unit</th>
                    <th>Monthly Rent</th>
                    <th>Due Date</th>
                    <th>No. of Tenants</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PagedPaymentRows.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No units found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.PagedPaymentRows.Items)
                    {
                        var collapseId = $"payments-room-{row.RoomId}";
                        var history = Model.PaymentHistoryByRoomId.TryGetValue(row.RoomId, out var roomPayments) ? roomPayments : [];

                        <tr>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-secondary room-payments-toggle" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(Model.ExpandedRoomId == row.RoomId ? "true" : "false")" aria-controls="@collapseId">View</button>
                            </td>
                            <td>
                                <div>@row.UnitRoomLabel</div>
                                <div class="text-muted small">@row.PropertyName</div>
                            </td>
                            <td>@row.MonthlyRent.ToString("N2")</td>
                            <td>@(row.DueDate?.ToString("MMM-dd-yyyy") ?? "-")</td>
                            <td>@row.TenantCountDisplay</td>
                            <td>@row.Status</td>
                        </tr>

                        <tr class="collapse @(Model.ExpandedRoomId == row.RoomId ? "show" : null)" id="@collapseId" data-room-id="@row.RoomId">
                            <td colspan="6" class="bg-light">
                                <div class="p-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                                        <strong class="app-section-title mb-0">Payment History - @row.UnitRoomLabel</strong>
                                        @if (row.HistoryHasOpenDue)
                                        {
                                            <span class="badge text-bg-light border text-dark">Select an unpaid or partial due below to add payment.</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>No unpaid due</button>
                                        }
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Due Date</th>
                                                    <th>Date Paid</th>
                                                    <th>Amount</th>
                                                    <th>Status</th>
                                                    <th>Method</th>
                                                    <th style="width: 180px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (history.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="6" class="text-center text-muted">No payment history yet.</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var payment in history)
                                                    {
                                                        <tr>
                                                            <td>@payment.DueDate.ToString("MMM-dd-yyyy")</td>
                                                            <td>@(payment.PaymentDate?.ToString("MMM-dd-yyyy") ?? "-")</td>
                                                            <td>@payment.AmountDue.ToString("N2")</td>
                                                            <td>@payment.Status</td>
                                                            <td>@(payment.PaymentMethod?.ToString() ?? "-")</td>
                                                            <td>
                                                                <div class="d-flex gap-2 flex-wrap">
                                                                    @if (payment.CanAddPayment && row.LeaseId.HasValue && payment.BalanceAmount > 0)
                                                                    {
                                                                        <button type="button"
                                                                                class="btn btn-sm btn-primary open-add-payment-modal"
                                                                                data-room-id="@row.RoomId"
                                                                                data-lease-id="@row.LeaseId"
                                                                                data-amount="@payment.BalanceAmount"
                                                                                data-unit-room="@row.UnitRoomLabel"
                                                                                data-due-date="@payment.DueDate.ToString("yyyy-MM-dd")">
                                                                            Add Payment
                                                                        </button>
                                                                    }

                                                                    @if (payment.CanEdit && payment.Id.HasValue && payment.PaymentDate.HasValue && payment.RecordedPaymentAmount.HasValue && payment.PaymentMethod.HasValue)
                                                                    {
                                                                        <button type="button"
                                                                                class="btn btn-sm btn-outline-warning open-edit-payment-modal"
                                                                                data-payment-id="@payment.Id.Value"
                                                                                data-room-id="@row.RoomId"
                                                                                data-amount="@payment.RecordedPaymentAmount.Value"
                                                                                data-payment-date="@payment.PaymentDate.Value.ToString("yyyy-MM-dd")"
                                                                                data-payment-method="@payment.PaymentMethod.Value"
                                                                                data-reference="@payment.ReferenceNumber"
                                                                                data-notes="@payment.Notes">
                                                                            Edit
                                                                        </button>
                                                                    }

                                                                    @if (!payment.CanAddPayment && !(payment.CanEdit && payment.Id.HasValue && payment.PaymentDate.HasValue && payment.RecordedPaymentAmount.HasValue && payment.PaymentMethod.HasValue))
                                                                    {
                                                                        <span class="text-muted">-</span>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/ApartmentTenants/Index",
    PageNumber = Model.PagedPaymentRows.PageNumber,
    TotalPages = Model.PagedPaymentRows.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["PropertySearch"] = Model.PropertySearch ?? string.Empty,
        ["PropertiesPageNumber"] = Model.PropertiesPageNumber.ToString(),
        ["DepositsPageNumber"] = Model.DepositsPageNumber.ToString(),
        ["ExpandedRoomId"] = Model.ExpandedRoomId?.ToString() ?? string.Empty
    }
})" />

<div class="modal fade" id="propertyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="propertyForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="propertyModalTitle">Property</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="propertyId" />
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" id="propertyName" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input class="form-control" id="propertyAddress" required maxlength="500" />
                    </div>
                    <div class="alert alert-danger d-none" id="propertyModalError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="unitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="unitForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="unitModalTitle">Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="unitId" />
                    <input type="hidden" id="unitPropertyId" />
                    <div class="mb-3">
                        <label class="form-label">Unit Number</label>
                        <input class="form-control" id="unitNumber" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Monthly Rent</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="unitMonthlyRent" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="unitMaxCapacity">Max Capacity</label>
                        <input type="number" step="1" min="0" inputmode="numeric" class="form-control" id="unitMaxCapacity" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="unitStatus">
                            <option value="1">Available</option>
                            <option value="2">Occupied</option>
                            <option value="3">Maintenance</option>
                            <option value="4">Inactive</option>
                        </select>
                    </div>
                    <div class="alert alert-danger d-none" id="unitModalError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="addPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddPayment" id="addPaymentForm">
                <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-2"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Add Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="AddPaymentInput.RoomId" id="addPaymentRoomId" />
                    <input type="hidden" asp-for="AddPaymentInput.LeaseId" id="addPaymentLeaseId" />
                    <input type="hidden" asp-for="AddPaymentInput.DueDate" id="addPaymentDueDateValue" />

                    <div class="mb-2">
                        <label class="form-label">Unit</label>
                        <input type="text" class="form-control" id="addPaymentUnitRoomLabel" readonly />
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddPaymentInput.Amount" class="form-label"></label>
                        <input asp-for="AddPaymentInput.Amount" class="form-control" id="addPaymentAmountInput" />
                        <span asp-validation-for="AddPaymentInput.Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddPaymentInput.DueDate" class="form-label"></label>
                        <input asp-for="AddPaymentInput.DueDate" type="text" class="form-control" id="addPaymentDueDate" readonly />
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddPaymentInput.PaymentDate" class="form-label"></label>
                        <input asp-for="AddPaymentInput.PaymentDate" class="form-control" type="date" id="addPaymentDateInput" />
                        <span asp-validation-for="AddPaymentInput.PaymentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddPaymentInput.PaymentMethod" class="form-label"></label>
                        <select asp-for="AddPaymentInput.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select" id="addPaymentMethodInput"></select>
                        <span asp-validation-for="AddPaymentInput.PaymentMethod" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit" id="addPaymentSubmitButton">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="page-header-block mt-4">
    <h2 class="mb-0">Deposits</h2>
</div>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>Deposit</th>
                    <th>Date Paid</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PagedDepositRows.Items.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No deposits found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.PagedDepositRows.Items)
                    {
                        var depositCollapseId = $"deposits-unit-{row.UnitId}";
                        var unitDepositHistory = Model.DepositHistoryByUnitId.TryGetValue(row.UnitId, out var deposits) ? deposits : [];

                        <tr>
                            <td>
                                <div>@row.UnitLabel</div>
                                <div class="text-muted small">@row.PropertyName</div>
                            </td>
                            <td>@(row.DepositAmount.HasValue ? row.DepositAmount.Value.ToString("N2") : "-")</td>
                            <td>@(row.DatePaid?.ToString("MMM-dd-yyyy") ?? "-")</td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    @if (row.DepositCount > 1)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary deposit-history-toggle"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@depositCollapseId"
                                                aria-expanded="@(Model.ExpandedDepositUnitId == row.UnitId ? "true" : "false")"
                                                aria-controls="@depositCollapseId">
                                            View Deposits
                                        </button>
                                    }

                                    @if (row.CanAddDeposit && row.LeaseId.HasValue)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-primary open-add-deposit-modal"
                                                data-unit-id="@row.UnitId"
                                                data-lease-id="@row.LeaseId"
                                                data-unit-label="@row.UnitLabel"
                                                data-property-name="@row.PropertyName"
                                                data-amount="0"
                                                data-due-date="@((row.DatePaid ?? DateTime.UtcNow.Date).ToString("yyyy-MM-dd"))">
                                            Add Deposit
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>No active lease</button>
                                    }
                                </div>
                            </td>
                        </tr>

                        <tr class="collapse @(Model.ExpandedDepositUnitId == row.UnitId ? "show" : null)" id="@depositCollapseId" data-deposit-unit-id="@row.UnitId">
                            <td colspan="4" class="bg-light">
                                <div class="p-2">
                                    <strong class="app-section-title mb-2">Deposit History - @row.UnitLabel</strong>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Date Paid</th>
                                                    <th>Deposit</th>
                                                    <th>Method</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (unitDepositHistory.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">No deposit history yet.</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var deposit in unitDepositHistory)
                                                    {
                                                        <tr>
                                                            <td>@deposit.PaymentDate.ToString("MMM-dd-yyyy")</td>
                                                            <td>@deposit.Amount.ToString("N2")</td>
                                                            <td>@deposit.PaymentMethod</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/ApartmentTenants/Index",
    PageParameterName = "DepositsPageNumber",
    PageNumber = Model.PagedDepositRows.PageNumber,
    TotalPages = Model.PagedDepositRows.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["PropertySearch"] = Model.PropertySearch ?? string.Empty,
        ["PropertiesPageNumber"] = Model.PropertiesPageNumber.ToString(),
        ["PageNumber"] = Model.PageNumber.ToString(),
        ["ExpandedRoomId"] = Model.ExpandedRoomId?.ToString() ?? string.Empty,
        ["ExpandedDepositUnitId"] = Model.ExpandedDepositUnitId?.ToString() ?? string.Empty
    }
})" />

<div class="modal fade" id="addDepositModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddDeposit" id="addDepositForm">
                <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-2"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Add Deposit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="AddDepositInput.UnitId" id="addDepositUnitId" />
                    <input type="hidden" asp-for="AddDepositInput.LeaseId" id="addDepositLeaseId" />
                    <input type="hidden" asp-for="AddDepositInput.DueDate" id="addDepositDueDateValue" />

                    <div class="mb-2">
                        <label class="form-label">Unit</label>
                        <input type="text" class="form-control" id="addDepositUnitLabel" readonly />
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddDepositInput.Amount" class="form-label">Deposit</label>
                        <input asp-for="AddDepositInput.Amount" type="number" step="0.01" min="0.01" required class="form-control" id="addDepositAmountInput" />
                        <span asp-validation-for="AddDepositInput.Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddDepositInput.DueDate" class="form-label"></label>
                        <input asp-for="AddDepositInput.DueDate" type="text" class="form-control" id="addDepositDueDate" readonly />
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddDepositInput.PaymentDate" class="form-label"></label>
                        <input asp-for="AddDepositInput.PaymentDate" class="form-control" type="date" id="addDepositDateInput" />
                        <span asp-validation-for="AddDepositInput.PaymentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddDepositInput.PaymentMethod" class="form-label"></label>
                        <select asp-for="AddDepositInput.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select" id="addDepositMethodInput"></select>
                        <span asp-validation-for="AddDepositInput.PaymentMethod" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save Deposit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditPayment">
                <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-2"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Edit Payment (Temporary)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditPaymentInput.PaymentId" id="editPaymentId" />
                    <input type="hidden" asp-for="EditPaymentInput.RoomId" id="editPaymentRoomId" />

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.Amount" class="form-label"></label>
                        <input asp-for="EditPaymentInput.Amount" type="number" step="0.01" min="0.01" required class="form-control" id="editPaymentAmountInput" />
                        <span asp-validation-for="EditPaymentInput.Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.PaymentDate" class="form-label"></label>
                        <input asp-for="EditPaymentInput.PaymentDate" class="form-control" type="date" id="editPaymentDateInput" />
                        <span asp-validation-for="EditPaymentInput.PaymentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.PaymentMethod" class="form-label"></label>
                        <select asp-for="EditPaymentInput.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select" id="editPaymentMethodInput"></select>
                        <span asp-validation-for="EditPaymentInput.PaymentMethod" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.ReferenceNumber" class="form-label"></label>
                        <input asp-for="EditPaymentInput.ReferenceNumber" class="form-control" id="editPaymentReferenceInput" />
                        <span asp-validation-for="EditPaymentInput.ReferenceNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.Notes" class="form-label"></label>
                        <textarea asp-for="EditPaymentInput.Notes" class="form-control" rows="2" id="editPaymentNotesInput"></textarea>
                        <span asp-validation-for="EditPaymentInput.Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const propertyModal = new bootstrap.Modal(document.getElementById('propertyModal'));
        const unitModal = new bootstrap.Modal(document.getElementById('unitModal'));
        const addPaymentModalElement = document.getElementById('addPaymentModal');
        const addPaymentModal = addPaymentModalElement ? new bootstrap.Modal(addPaymentModalElement) : null;
        const addDepositModalElement = document.getElementById('addDepositModal');
        const addDepositModal = addDepositModalElement ? new bootstrap.Modal(addDepositModalElement) : null;
        const editPaymentModalElement = document.getElementById('editPaymentModal');
        const editPaymentModal = editPaymentModalElement ? new bootstrap.Modal(editPaymentModalElement) : null;

        function clearStaleModalBackdropArtifacts() {
            document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('padding-right');
            document.body.style.removeProperty('overflow');
        }

        // Defensive cleanup in case browser navigation leaves stale modal artifacts.
        clearStaleModalBackdropArtifacts();

        document.querySelectorAll('.modal').forEach(modalElement => {
            modalElement.addEventListener('hidden.bs.modal', function () {
                if (!document.querySelector('.modal.show')) {
                    clearStaleModalBackdropArtifacts();
                }
            });
        });

        if (@Model.ShowAddPaymentModal.ToString().ToLowerInvariant()) {
            addPaymentModal?.show();
        }

        if (@Model.ShowAddDepositModal.ToString().ToLowerInvariant()) {
            addDepositModal?.show();
        }

        if (@Model.ShowEditPaymentModal.ToString().ToLowerInvariant()) {
            editPaymentModal?.show();
        }

        function showError(elementId, message) {
            const el = document.getElementById(elementId);
            el.textContent = message;
            el.classList.remove('d-none');
        }

        function clearError(elementId) {
            const el = document.getElementById(elementId);
            el.textContent = '';
            el.classList.add('d-none');
        }

        function getUnitStatusValue(status) {
            if (typeof status === 'number' && Number.isFinite(status)) {
                return String(status);
            }

            const normalizedStatus = String(status ?? '').trim();
            if (/^\d+$/.test(normalizedStatus)) {
                return normalizedStatus;
            }

            const statusMap = { Available: '1', Occupied: '2', Maintenance: '3', Inactive: '4' };
            return statusMap[normalizedStatus] ?? '1';
        }

        function buildUnitPayload() {
            const propertyId = Number(document.getElementById('unitPropertyId').value);
            const unitNumberInput = document.getElementById('unitNumber');
            const unitMonthlyRentInput = document.getElementById('unitMonthlyRent');
            const unitMaxCapacityInput = document.getElementById('unitMaxCapacity');
            const unitNumber = unitNumberInput.value.trim();
            const monthlyRentRaw = unitMonthlyRentInput.value.trim().replace(/,/g, '');
            const monthlyRent = Number(monthlyRentRaw);
            const maxCapacityRaw = unitMaxCapacityInput.value.trim();
            const maxCapacity = Number(maxCapacityRaw);

            if (!Number.isInteger(propertyId) || propertyId <= 0) {
                showError('unitModalError', 'Property is required.');
                return null;
            }

            if (!unitNumber) {
                showError('unitModalError', 'Unit name is required.');
                return null;
            }

            if (!monthlyRentRaw || !Number.isFinite(monthlyRent) || monthlyRent < 0) {
                showError('unitModalError', 'Monthly rent must be a valid amount.');
                return null;
            }

            if (!maxCapacityRaw || !Number.isInteger(maxCapacity) || maxCapacity < 0) {
                showError('unitModalError', 'Max capacity must be a whole number zero or greater.');
                return null;
            }

            unitNumberInput.value = unitNumber;
            unitMonthlyRentInput.value = monthlyRentRaw;
            unitMaxCapacityInput.value = String(maxCapacity);

            return {
                propertyId,
                unitNumber,
                monthlyRent,
                maxCapacity,
                status: Number(document.getElementById('unitStatus').value)
            };
        }

        function resetModalArtifacts() {
            document.querySelectorAll('.modal.show').forEach(modalElement => {
                bootstrap.Modal.getOrCreateInstance(modalElement).hide();
            });

            clearStaleModalBackdropArtifacts();
        }

        async function replaceAppContentFromHtml(html, urlToPush) {
            resetModalArtifacts();

            const appContent = document.querySelector('.app-content');
            if (!appContent) {
                window.location.href = urlToPush || window.location.href;
                return;
            }

            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const nextContent = doc.querySelector('.app-content');
            if (!nextContent) {
                window.location.href = urlToPush || window.location.href;
                return;
            }

            appContent.innerHTML = nextContent.innerHTML;

            const scripts = Array.from(appContent.querySelectorAll('script'));
            scripts.forEach(oldScript => {
                const newScript = document.createElement('script');
                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));

                if (oldScript.src) {
                    const exists = document.querySelector(`script[src='${oldScript.getAttribute('src')}']`);
                    if (!exists) {
                        document.body.appendChild(newScript);
                    }
                } else {
                    newScript.text = oldScript.text;
                    document.body.appendChild(newScript);
                }

                oldScript.remove();
            });

            if (urlToPush) {
                window.history.pushState({}, '', urlToPush);
            }
        }

        async function refreshCurrentPageContent() {
            const url = window.location.href;
            const response = await fetch(url, {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            });

            if (!response.ok) {
                window.location.reload();
                return;
            }

            const html = await response.text();
            await replaceAppContentFromHtml(html, url);
        }

        const propertyCollapseRows = Array.from(document.querySelectorAll('tr.property-collapse'));
        const unitCollapseRows = Array.from(document.querySelectorAll('tr.unit-collapse'));
        const roomPaymentRows = Array.from(document.querySelectorAll('tr.collapse[data-room-id]'));
        const depositHistoryRows = Array.from(document.querySelectorAll('tr.collapse[data-deposit-unit-id]'));
        const propertiesOpenStorageKey = 'apartmentTenants:lastOpenPropertyId';

        function closeOtherRows(rows, currentTargetSelector) {
            rows.forEach(row => {
                const selector = `#${row.id}`;
                if (selector !== currentTargetSelector && row.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(row, { toggle: false }).hide();
                }
            });
        }

        document.querySelectorAll('.property-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;

                const propertyId = this.getAttribute('data-property-id') || '';
                const targetRow = document.querySelector(targetSelector);
                if (targetRow && !targetRow.classList.contains('show')) {
                    sessionStorage.setItem(propertiesOpenStorageKey, propertyId);
                } else {
                    sessionStorage.removeItem(propertiesOpenStorageKey);
                }

                closeOtherRows(propertyCollapseRows, targetSelector);
            });
        });

        document.querySelectorAll('.unit-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;
                closeOtherRows(unitCollapseRows, targetSelector);
            });
        });

        document.querySelectorAll('.room-payments-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;
                closeOtherRows(roomPaymentRows, targetSelector);
            });
        });

        document.querySelectorAll('.deposit-history-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;
                closeOtherRows(depositHistoryRows, targetSelector);
            });
        });

        window.openAddPropertyModal = function () {
            clearError('propertyModalError');
            document.getElementById('propertyModalTitle').textContent = 'Add Property';
            document.getElementById('propertyId').value = '';
            document.getElementById('propertyName').value = '';
            document.getElementById('propertyAddress').value = '';
            propertyModal.show();
        }

        window.openEditPropertyModal = function (property) {
            clearError('propertyModalError');
            document.getElementById('propertyModalTitle').textContent = 'Edit Property';
            document.getElementById('propertyId').value = property.Id;
            document.getElementById('propertyName').value = property.Name ?? '';
            document.getElementById('propertyAddress').value = property.Address ?? '';
            propertyModal.show();
        }

        window.openAddUnitModal = function (propertyId) {
            clearError('unitModalError');
            sessionStorage.setItem(propertiesOpenStorageKey, String(propertyId));
            document.getElementById('unitModalTitle').textContent = 'Add Unit';
            document.getElementById('unitId').value = '';
            document.getElementById('unitPropertyId').value = propertyId;
            document.getElementById('unitNumber').value = '';
            document.getElementById('unitMonthlyRent').value = '';
            document.getElementById('unitMaxCapacity').value = '0';
            document.getElementById('unitStatus').value = '1';
            unitModal.show();
        }

        window.openEditUnitModal = function (unit) {
            clearError('unitModalError');
            document.getElementById('unitModalTitle').textContent = 'Edit Unit';
            document.getElementById('unitId').value = unit.Id;
            document.getElementById('unitPropertyId').value = unit.PropertyId;
            document.getElementById('unitNumber').value = unit.UnitNumber ?? '';
            document.getElementById('unitMonthlyRent').value = unit.MonthlyRent ?? 0;
            document.getElementById('unitMaxCapacity').value = unit.MaxCapacity ?? 0;
            document.getElementById('unitStatus').value = getUnitStatusValue(unit.Status);
            unitModal.show();
        }

        const lastOpenPropertyId = sessionStorage.getItem(propertiesOpenStorageKey);
        if (lastOpenPropertyId) {
            const propertyToggleButton = document.querySelector(`.property-toggle[data-property-id='${lastOpenPropertyId}']`);
            const targetSelector = propertyToggleButton?.getAttribute('data-bs-target');
            if (propertyToggleButton && targetSelector) {
                closeOtherRows(propertyCollapseRows, targetSelector);
                const targetRow = document.querySelector(targetSelector);
                if (targetRow && !targetRow.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(targetRow, { toggle: false }).show();
                }
            }
        }

        document.getElementById('propertyForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearError('propertyModalError');

            const id = document.getElementById('propertyId').value;
            const payload = {
                name: document.getElementById('propertyName').value,
                address: document.getElementById('propertyAddress').value
            };

            const response = await fetch(id ? `/api/properties/${id}` : '/api/properties', {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const friendlyMessage = await window.getFriendlyErrorMessage(response, 'Unable to save property right now. Please try again.');
                window.showFriendlyErrorModal(friendlyMessage, 'Save Property');
                return;
            }

            window.location.reload();
        });

        document.getElementById('unitForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearError('unitModalError');

            const id = document.getElementById('unitId').value;
            const selectedPropertyId = document.getElementById('unitPropertyId').value;
            if (selectedPropertyId) {
                sessionStorage.setItem(propertiesOpenStorageKey, selectedPropertyId);
            }

            const payload = buildUnitPayload();
            if (!payload) {
                return;
            }

            const response = await fetch(id ? `/api/units/${id}` : '/api/units', {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const friendlyMessage = await window.getFriendlyErrorMessage(response, 'Unable to save unit right now. Please try again.');
                window.showFriendlyErrorModal(friendlyMessage, 'Save Unit');
                return;
            }

            window.location.reload();
        });

        window.hardDeleteProperty = async function (propertyId) {
            if (!confirm('Permanently delete this property and all related unit records?')) {
                return;
            }

            const response = await fetch(`/api/properties/${propertyId}/hard`, {
                method: 'DELETE'
            });

            if (!response.ok) {
                const friendlyMessage = await window.getFriendlyErrorMessage(response, 'Unable to delete property right now. Please try again.');
                window.showFriendlyErrorModal(friendlyMessage, 'Delete Property');
                return;
            }

            window.location.reload();
        }

        window.hardDeleteUnit = async function (unitId) {
            if (!confirm('Permanently delete this unit and all related records?')) {
                return;
            }

            const response = await fetch(`/api/units/${unitId}/hard`, {
                method: 'DELETE'
            });

            if (!response.ok) {
                const friendlyMessage = await window.getFriendlyErrorMessage(response, 'Unable to delete unit right now. Please try again.');
                window.showFriendlyErrorModal(friendlyMessage, 'Delete Unit');
                return;
            }

            window.location.reload();
        }

        const addPaymentRoomIdInput = document.getElementById('addPaymentRoomId');
        const addPaymentLeaseIdInput = document.getElementById('addPaymentLeaseId');
        const addPaymentAmountInput = document.getElementById('addPaymentAmountInput');
        const addPaymentUnitRoomLabelInput = document.getElementById('addPaymentUnitRoomLabel');
        const addPaymentDueDateInput = document.getElementById('addPaymentDueDate');
        const addPaymentDueDateValueInput = document.getElementById('addPaymentDueDateValue');
        const addPaymentDateInput = document.getElementById('addPaymentDateInput');
        const addPaymentForm = document.getElementById('addPaymentForm');
        const addPaymentSubmitButton = document.getElementById('addPaymentSubmitButton');

        document.querySelectorAll('.open-add-payment-modal').forEach(button => {
            button.addEventListener('click', function () {
                const roomId = this.dataset.roomId || '';
                const leaseId = this.dataset.leaseId || '';
                const amount = this.dataset.amount || '';
                const unitRoom = this.dataset.unitRoom || '';
                const dueDate = this.dataset.dueDate || '';

                if (addPaymentRoomIdInput) addPaymentRoomIdInput.value = roomId;
                if (addPaymentLeaseIdInput) addPaymentLeaseIdInput.value = leaseId;
                if (addPaymentAmountInput) {
                    addPaymentAmountInput.value = Number(amount).toFixed(2);
                    addPaymentAmountInput.setCustomValidity('');
                }
                if (addPaymentUnitRoomLabelInput) addPaymentUnitRoomLabelInput.value = unitRoom;
                if (addPaymentDueDateInput) addPaymentDueDateInput.value = dueDate;
                if (addPaymentDueDateValueInput) addPaymentDueDateValueInput.value = dueDate;
                if (addPaymentDateInput) addPaymentDateInput.value = dueDate;

                if (addPaymentForm) {
                    delete addPaymentForm.dataset.submitting;
                }
                if (addPaymentSubmitButton) {
                    addPaymentSubmitButton.disabled = false;
                    addPaymentSubmitButton.textContent = 'Save Payment';
                }

                addPaymentModal?.show();
            });
        });

        addPaymentForm?.addEventListener('submit', function (e) {
            if (!addPaymentAmountInput) {
                return;
            }

            const amountValue = Number(addPaymentAmountInput.value);
            if (!Number.isFinite(amountValue) || amountValue <= 0) {
                e.preventDefault();
                addPaymentAmountInput.setCustomValidity('Payment amount must be greater than zero.');
                addPaymentAmountInput.reportValidity();
                if (addPaymentSubmitButton) {
                    addPaymentSubmitButton.disabled = false;
                    addPaymentSubmitButton.textContent = 'Save Payment';
                }
                if (addPaymentForm) {
                    delete addPaymentForm.dataset.submitting;
                }
                return;
            }

            addPaymentAmountInput.setCustomValidity('');

            if (addPaymentForm?.dataset.submitting === 'true') {
                e.preventDefault();
                return;
            }

            if (addPaymentForm) {
                addPaymentForm.dataset.submitting = 'true';
            }

            if (addPaymentSubmitButton) {
                addPaymentSubmitButton.disabled = true;
                addPaymentSubmitButton.textContent = 'Saving...';
            }

            clearStaleModalBackdropArtifacts();
        });

        // Keep Add Payment on normal Razor Pages POST/Redirect/GET navigation.
        // Avoid AJAX partial content replacement here because re-injected inline scripts
        // can leave stale client state that blocks reopening the modal on subsequent attempts.

        const addDepositUnitIdInput = document.getElementById('addDepositUnitId');
        const addDepositLeaseIdInput = document.getElementById('addDepositLeaseId');
        const addDepositAmountInput = document.getElementById('addDepositAmountInput');
        const addDepositUnitLabelInput = document.getElementById('addDepositUnitLabel');
        const addDepositDueDateInput = document.getElementById('addDepositDueDate');
        const addDepositDueDateValueInput = document.getElementById('addDepositDueDateValue');

        document.querySelectorAll('.open-add-deposit-modal').forEach(button => {
            button.addEventListener('click', function () {
                const unitId = this.dataset.unitId || '';
                const leaseId = this.dataset.leaseId || '';
                const amount = this.dataset.amount || '';
                const unitLabel = this.dataset.unitLabel || '';
                const propertyName = this.dataset.propertyName || '';
                const dueDate = this.dataset.dueDate || '';

                if (addDepositUnitIdInput) addDepositUnitIdInput.value = unitId;
                if (addDepositLeaseIdInput) addDepositLeaseIdInput.value = leaseId;
                if (addDepositAmountInput) {
                    addDepositAmountInput.value = amount && Number(amount) > 0 ? Number(amount).toFixed(2) : '';
                    addDepositAmountInput.setCustomValidity('');
                }
                if (addDepositUnitLabelInput) addDepositUnitLabelInput.value = `${unitLabel} - ${propertyName}`;
                if (addDepositDueDateInput) addDepositDueDateInput.value = dueDate;
                if (addDepositDueDateValueInput) addDepositDueDateValueInput.value = dueDate;

                addDepositModal?.show();
            });
        });

        const addDepositForm = document.getElementById('addDepositForm');
        addDepositForm?.addEventListener('submit', function (e) {
            if (!addDepositAmountInput) {
                return;
            }

            const amountValue = Number(addDepositAmountInput.value);
            if (!Number.isFinite(amountValue) || amountValue <= 0) {
                e.preventDefault();
                addDepositAmountInput.setCustomValidity('Deposit amount must be greater than zero.');
                addDepositAmountInput.reportValidity();
                return;
            }

            addDepositAmountInput.setCustomValidity('');
            clearStaleModalBackdropArtifacts();
        });

        // Keep Add Deposit on normal Razor Pages POST/Redirect/GET navigation for consistency
        // with Add Payment and to prevent stale modal/listener state after dynamic script reinjection.

        const editPaymentIdInput = document.getElementById('editPaymentId');
        const editPaymentRoomIdInput = document.getElementById('editPaymentRoomId');
        const editPaymentAmountInput = document.getElementById('editPaymentAmountInput');
        const editPaymentDateInput = document.getElementById('editPaymentDateInput');
        const editPaymentMethodInput = document.getElementById('editPaymentMethodInput');
        const editPaymentReferenceInput = document.getElementById('editPaymentReferenceInput');
        const editPaymentNotesInput = document.getElementById('editPaymentNotesInput');
        const editPaymentForm = editPaymentIdInput?.closest('form') || null;

        document.querySelectorAll('.open-edit-payment-modal').forEach(button => {
            button.addEventListener('click', function () {
                if (editPaymentIdInput) editPaymentIdInput.value = this.dataset.paymentId || '';
                if (editPaymentRoomIdInput) editPaymentRoomIdInput.value = this.dataset.roomId || '';
                if (editPaymentAmountInput) {
                    editPaymentAmountInput.value = Number(this.dataset.amount || 0).toFixed(2);
                    editPaymentAmountInput.setCustomValidity('');
                }
                if (editPaymentDateInput) editPaymentDateInput.value = this.dataset.paymentDate || '';
                if (editPaymentMethodInput) editPaymentMethodInput.value = this.dataset.paymentMethod || 'Cash';
                if (editPaymentReferenceInput) editPaymentReferenceInput.value = this.dataset.reference || '';
                if (editPaymentNotesInput) editPaymentNotesInput.value = this.dataset.notes || '';
                editPaymentModal?.show();
            });
        });

        editPaymentForm?.addEventListener('submit', function (e) {
            if (!editPaymentAmountInput) {
                return;
            }

            const amountValue = Number(editPaymentAmountInput.value);
            if (!Number.isFinite(amountValue) || amountValue <= 0) {
                e.preventDefault();
                editPaymentAmountInput.setCustomValidity('Amount must be greater than zero.');
                editPaymentAmountInput.reportValidity();
                return;
            }

            editPaymentAmountInput.setCustomValidity('');
            clearStaleModalBackdropArtifacts();
        });

        const expandedRoomId = '@(Model.ExpandedRoomId?.ToString() ?? string.Empty)';
        if (expandedRoomId) {
            const row = document.querySelector(`tr.collapse[data-room-id='${expandedRoomId}']`);
            if (row && !row.classList.contains('show')) {
                closeOtherRows(roomPaymentRows, `#${row.id}`);
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(row, { toggle: false });
                bsCollapse.show();
            }
        }

        const expandedDepositUnitId = '@(Model.ExpandedDepositUnitId?.ToString() ?? string.Empty)';
        if (expandedDepositUnitId) {
            const row = document.querySelector(`tr.collapse[data-deposit-unit-id='${expandedDepositUnitId}']`);
            if (row && !row.classList.contains('show')) {
                closeOtherRows(depositHistoryRows, `#${row.id}`);
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(row, { toggle: false });
                bsCollapse.show();
            }
        }
    </script>
}

