                    </div>

                    <div class="mb-2">
                        <label asp-for="AddDepositInput.PaymentMethod" class="form-label"></label>
                        <select asp-for="AddDepositInput.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select" id="addDepositMethodInput"></select>
                        <span asp-validation-for="AddDepositInput.PaymentMethod" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save Deposit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditPayment">
                <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-2"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Edit Payment (Temporary)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditPaymentInput.PaymentId" id="editPaymentId" />
                    <input type="hidden" asp-for="EditPaymentInput.RoomId" id="editPaymentRoomId" />

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.Amount" class="form-label"></label>
                        <input asp-for="EditPaymentInput.Amount" class="form-control" id="editPaymentAmountInput" />
                        <span asp-validation-for="EditPaymentInput.Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.PaymentDate" class="form-label"></label>
                        <input asp-for="EditPaymentInput.PaymentDate" class="form-control" type="date" id="editPaymentDateInput" />
                        <span asp-validation-for="EditPaymentInput.PaymentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.PaymentMethod" class="form-label"></label>
                        <select asp-for="EditPaymentInput.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select" id="editPaymentMethodInput"></select>
                        <span asp-validation-for="EditPaymentInput.PaymentMethod" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.ReferenceNumber" class="form-label"></label>
                        <input asp-for="EditPaymentInput.ReferenceNumber" class="form-control" id="editPaymentReferenceInput" />
                        <span asp-validation-for="EditPaymentInput.ReferenceNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="EditPaymentInput.Notes" class="form-label"></label>
                        <textarea asp-for="EditPaymentInput.Notes" class="form-control" rows="2" id="editPaymentNotesInput"></textarea>
                        <span asp-validation-for="EditPaymentInput.Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const propertyModal = new bootstrap.Modal(document.getElementById('propertyModal'));
        const unitModal = new bootstrap.Modal(document.getElementById('unitModal'));
        const addPaymentModalElement = document.getElementById('addPaymentModal');
        const addPaymentModal = addPaymentModalElement ? new bootstrap.Modal(addPaymentModalElement) : null;
        const addDepositModalElement = document.getElementById('addDepositModal');
        const addDepositModal = addDepositModalElement ? new bootstrap.Modal(addDepositModalElement) : null;
        const editPaymentModalElement = document.getElementById('editPaymentModal');
        const editPaymentModal = editPaymentModalElement ? new bootstrap.Modal(editPaymentModalElement) : null;

        if (@Model.ShowAddPaymentModal.ToString().ToLowerInvariant()) {
            addPaymentModal?.show();
        }

        if (@Model.ShowEditPaymentModal.ToString().ToLowerInvariant()) {
            editPaymentModal?.show();
        }

        function showError(elementId, message) {
            const el = document.getElementById(elementId);
            el.textContent = message;
            el.classList.remove('d-none');
        }

        function clearError(elementId) {
            const el = document.getElementById(elementId);
            el.textContent = '';
            el.classList.add('d-none');
        }

        async function replaceAppContentFromHtml(html, urlToPush) {
            const appContent = document.querySelector('.app-content');
            if (!appContent) {
                window.location.href = urlToPush || window.location.href;
                return;
            }

            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const nextContent = doc.querySelector('.app-content');
            if (!nextContent) {
                window.location.href = urlToPush || window.location.href;
                return;
            }

            appContent.innerHTML = nextContent.innerHTML;

            const scripts = Array.from(appContent.querySelectorAll('script'));
            scripts.forEach(oldScript => {
                const newScript = document.createElement('script');
                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));

                if (oldScript.src) {
                    const exists = document.querySelector(`script[src='${oldScript.getAttribute('src')}']`);
                    if (!exists) {
                        document.body.appendChild(newScript);
                    }
                } else {
                    newScript.text = oldScript.text;
                    document.body.appendChild(newScript);
                }

                oldScript.remove();
            });

            if (urlToPush) {
                window.history.pushState({}, '', urlToPush);
            }
        }

        async function refreshCurrentPageContent() {
            const url = window.location.href;
            const response = await fetch(url, {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            });

            if (!response.ok) {
                window.location.reload();
                return;
            }

            const html = await response.text();
            await replaceAppContentFromHtml(html, url);
        }

        const propertyCollapseRows = Array.from(document.querySelectorAll('tr.property-collapse'));
        const unitCollapseRows = Array.from(document.querySelectorAll('tr.unit-collapse'));
        const roomPaymentRows = Array.from(document.querySelectorAll('tr.collapse[data-room-id]'));
        const depositHistoryRows = Array.from(document.querySelectorAll('tr.collapse[data-deposit-unit-id]'));
        const propertiesOpenStorageKey = 'apartmentTenants:lastOpenPropertyId';

        function closeOtherRows(rows, currentTargetSelector) {
            rows.forEach(row => {
                const selector = `#${row.id}`;
                if (selector !== currentTargetSelector && row.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(row, { toggle: false }).hide();
                }
            });
        }

        document.querySelectorAll('.property-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;

                const propertyId = this.getAttribute('data-property-id') || '';
                const targetRow = document.querySelector(targetSelector);
                if (targetRow && !targetRow.classList.contains('show')) {
                    sessionStorage.setItem(propertiesOpenStorageKey, propertyId);
                } else {
                    sessionStorage.removeItem(propertiesOpenStorageKey);
                }

                closeOtherRows(propertyCollapseRows, targetSelector);
            });
        });

        document.querySelectorAll('.unit-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;
                closeOtherRows(unitCollapseRows, targetSelector);
            });
        });

        document.querySelectorAll('.room-payments-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;
                closeOtherRows(roomPaymentRows, targetSelector);
            });
        });

        document.querySelectorAll('.deposit-history-toggle').forEach(button => {
            button.addEventListener('click', function () {
                const targetSelector = this.getAttribute('data-bs-target');
                if (!targetSelector) return;
                closeOtherRows(depositHistoryRows, targetSelector);
            });
        });

        window.openAddPropertyModal = function () {
            clearError('propertyModalError');
            document.getElementById('propertyModalTitle').textContent = 'Add Property';
            document.getElementById('propertyId').value = '';
            document.getElementById('propertyName').value = '';
            document.getElementById('propertyAddress').value = '';
            propertyModal.show();
        }

        window.openEditPropertyModal = function (property) {
            clearError('propertyModalError');
            document.getElementById('propertyModalTitle').textContent = 'Edit Property';
            document.getElementById('propertyId').value = property.Id;
            document.getElementById('propertyName').value = property.Name ?? '';
            document.getElementById('propertyAddress').value = property.Address ?? '';
            propertyModal.show();
        }

        window.openAddUnitModal = function (propertyId) {
            clearError('unitModalError');
            sessionStorage.setItem(propertiesOpenStorageKey, String(propertyId));
            document.getElementById('unitModalTitle').textContent = 'Add Unit';
            document.getElementById('unitId').value = '';
            document.getElementById('unitPropertyId').value = propertyId;
            document.getElementById('unitNumber').value = '';
            document.getElementById('unitMonthlyRent').value = '';
            document.getElementById('unitRoomCount').value = '1';
            document.getElementById('unitRoomMaxCapacity').value = '3';
            document.getElementById('unitStatus').value = '1';
            unitModal.show();
        }

        window.openEditUnitModal = function (unit) {
            clearError('unitModalError');
            document.getElementById('unitModalTitle').textContent = 'Edit Unit';
            document.getElementById('unitId').value = unit.Id;
            document.getElementById('unitPropertyId').value = unit.PropertyId;
            document.getElementById('unitNumber').value = unit.UnitNumber ?? '';
            document.getElementById('unitMonthlyRent').value = unit.MonthlyRent ?? 0;
            document.getElementById('unitRoomCount').value = unit.RoomCount ?? 1;
            document.getElementById('unitRoomMaxCapacity').value = unit.RoomMaxCapacity ?? 3;
            const statusMap = { 'Available': '1', 'Occupied': '2', 'Maintenance': '3', 'Inactive': '4' };
            document.getElementById('unitStatus').value = statusMap[unit.Status] ?? '1';
            unitModal.show();
        }

        const lastOpenPropertyId = sessionStorage.getItem(propertiesOpenStorageKey);
        if (lastOpenPropertyId) {
            const propertyToggleButton = document.querySelector(`.property-toggle[data-property-id='${lastOpenPropertyId}']`);
            const targetSelector = propertyToggleButton?.getAttribute('data-bs-target');
            if (propertyToggleButton && targetSelector) {
                closeOtherRows(propertyCollapseRows, targetSelector);
                const targetRow = document.querySelector(targetSelector);
                if (targetRow && !targetRow.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(targetRow, { toggle: false }).show();
                }
            }
        }

        document.getElementById('propertyForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearError('propertyModalError');

            const id = document.getElementById('propertyId').value;
            const payload = {
                name: document.getElementById('propertyName').value,
                address: document.getElementById('propertyAddress').value
            };

            const response = await fetch(id ? `/api/properties/${id}` : '/api/properties', {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const text = await response.text();
                showError('propertyModalError', text || 'Failed to save property.');
                return;
            }

            propertyModal.hide();
            await refreshCurrentPageContent();
        });

        document.getElementById('unitForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearError('unitModalError');

            const id = document.getElementById('unitId').value;
            const selectedPropertyId = document.getElementById('unitPropertyId').value;
            if (selectedPropertyId) {
                sessionStorage.setItem(propertiesOpenStorageKey, selectedPropertyId);
            }

            const payload = {
                propertyId: Number(document.getElementById('unitPropertyId').value),
                unitNumber: document.getElementById('unitNumber').value,
                monthlyRent: Number(document.getElementById('unitMonthlyRent').value),
                roomCount: Number(document.getElementById('unitRoomCount').value),
                roomMaxCapacity: Number(document.getElementById('unitRoomMaxCapacity').value),
                status: Number(document.getElementById('unitStatus').value)
            };

            const response = await fetch(id ? `/api/units/${id}` : '/api/units', {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const text = await response.text();
                showError('unitModalError', text || 'Failed to save unit.');
                return;
            }

            unitModal.hide();
            await refreshCurrentPageContent();
        });

        const addPaymentRoomIdInput = document.getElementById('addPaymentRoomId');
        const addPaymentLeaseIdInput = document.getElementById('addPaymentLeaseId');
        const addPaymentAmountInput = document.getElementById('addPaymentAmountInput');
        const addPaymentUnitRoomLabelInput = document.getElementById('addPaymentUnitRoomLabel');
        const addPaymentDueDateInput = document.getElementById('addPaymentDueDate');

        document.querySelectorAll('.open-add-payment-modal').forEach(button => {
            button.addEventListener('click', function () {
                const roomId = this.dataset.roomId || '';
                const leaseId = this.dataset.leaseId || '';
                const amount = this.dataset.amount || '';
                const unitRoom = this.dataset.unitRoom || '';
                const dueDate = this.dataset.dueDate || '';

                if (addPaymentRoomIdInput) addPaymentRoomIdInput.value = roomId;
                if (addPaymentLeaseIdInput) addPaymentLeaseIdInput.value = leaseId;
                if (addPaymentAmountInput) addPaymentAmountInput.value = Number(amount).toFixed(2);
                if (addPaymentUnitRoomLabelInput) addPaymentUnitRoomLabelInput.value = unitRoom;
                if (addPaymentDueDateInput) addPaymentDueDateInput.value = dueDate;

                addPaymentModal?.show();
            });
        });

        const addPaymentForm = document.getElementById('addPaymentForm');
        addPaymentForm?.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(addPaymentForm);
            const response = await fetch(addPaymentForm.getAttribute('action') || window.location.href, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            });

            const html = await response.text();
            await replaceAppContentFromHtml(html, window.location.href);
        });

        const addDepositUnitIdInput = document.getElementById('addDepositUnitId');
        const addDepositLeaseIdInput = document.getElementById('addDepositLeaseId');
        const addDepositAmountInput = document.getElementById('addDepositAmountInput');
        const addDepositUnitLabelInput = document.getElementById('addDepositUnitLabel');

        document.querySelectorAll('.open-add-deposit-modal').forEach(button => {
            button.addEventListener('click', function () {
                const unitId = this.dataset.unitId || '';
                const leaseId = this.dataset.leaseId || '';
                const amount = this.dataset.amount || '';
                const unitLabel = this.dataset.unitLabel || '';
                const propertyName = this.dataset.propertyName || '';

                if (addDepositUnitIdInput) addDepositUnitIdInput.value = unitId;
                if (addDepositLeaseIdInput) addDepositLeaseIdInput.value = leaseId;
                if (addDepositAmountInput) addDepositAmountInput.value = amount && Number(amount) > 0 ? Number(amount).toFixed(2) : '';
                if (addDepositUnitLabelInput) addDepositUnitLabelInput.value = `${unitLabel} - ${propertyName}`;

                addDepositModal?.show();
            });
        });

        const addDepositForm = document.getElementById('addDepositForm');
        addDepositForm?.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(addDepositForm);
            const response = await fetch(addDepositForm.getAttribute('action') || window.location.href, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            });

            const html = await response.text();
            await replaceAppContentFromHtml(html, window.location.href);
        });

        const editPaymentIdInput = document.getElementById('editPaymentId');
        const editPaymentRoomIdInput = document.getElementById('editPaymentRoomId');
        const editPaymentAmountInput = document.getElementById('editPaymentAmountInput');
        const editPaymentDateInput = document.getElementById('editPaymentDateInput');
        const editPaymentMethodInput = document.getElementById('editPaymentMethodInput');
        const editPaymentReferenceInput = document.getElementById('editPaymentReferenceInput');
        const editPaymentNotesInput = document.getElementById('editPaymentNotesInput');

        document.querySelectorAll('.open-edit-payment-modal').forEach(button => {
            button.addEventListener('click', function () {
                if (editPaymentIdInput) editPaymentIdInput.value = this.dataset.paymentId || '';
                if (editPaymentRoomIdInput) editPaymentRoomIdInput.value = this.dataset.roomId || '';
                if (editPaymentAmountInput) editPaymentAmountInput.value = Number(this.dataset.amount || 0).toFixed(2);
                if (editPaymentDateInput) editPaymentDateInput.value = this.dataset.paymentDate || '';
                if (editPaymentMethodInput) editPaymentMethodInput.value = this.dataset.paymentMethod || 'Cash';
                if (editPaymentReferenceInput) editPaymentReferenceInput.value = this.dataset.reference || '';
                if (editPaymentNotesInput) editPaymentNotesInput.value = this.dataset.notes || '';
                editPaymentModal?.show();
            });
        });

        const expandedRoomId = '@(Model.ExpandedRoomId?.ToString() ?? string.Empty)';
        if (expandedRoomId) {
            const row = document.querySelector(`tr.collapse[data-room-id='${expandedRoomId}']`);
            if (row && !row.classList.contains('show')) {
                closeOtherRows(roomPaymentRows, `#${row.id}`);
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(row, { toggle: false });
                bsCollapse.show();
            }
        }

        const expandedDepositUnitId = '@(Model.ExpandedDepositUnitId?.ToString() ?? string.Empty)';
        if (expandedDepositUnitId) {
            const row = document.querySelector(`tr.collapse[data-deposit-unit-id='${expandedDepositUnitId}']`);
            if (row && !row.classList.contains('show')) {
                closeOtherRows(depositHistoryRows, `#${row.id}`);
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(row, { toggle: false });
                bsCollapse.show();
            }
        }
    </script>
}
