        ["PageNumber"] = Model.PageNumber.ToString(),
        ["ExpandedRoomId"] = Model.ExpandedRoomId?.ToString() ?? string.Empty,
        ["ExpandedDepositUnitId"] = Model.ExpandedDepositUnitId?.ToString() ?? string.Empty
    }
})" />

<div class="modal fade" id="addDepositModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddDeposit" id="addDepositForm">
                <div asp-validation-summary="ModelOnly" class="text-danger px-3 pt-2"></div>
                <div class="modal-header">
                    <h5 class="modal-title">Add Deposit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="AddDepositInput.UnitId" id="addDepositUnitId" />
                    <input type="hidden" asp-for="AddDepositInput.LeaseId" id="addDepositLeaseId" />

                    <div class="mb-2">
                        <label class="form-label">Unit</label>
                        <input type="text" class="form-control" id="addDepositUnitLabel" readonly />
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddDepositInput.Amount" class="form-label">Deposit</label>
                        <input asp-for="AddDepositInput.Amount" class="form-control" id="addDepositAmountInput" />
                        <span asp-validation-for="AddDepositInput.Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="AddDepositInput.PaymentDate" class="form-label"></label>
