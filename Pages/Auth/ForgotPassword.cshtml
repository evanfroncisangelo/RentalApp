@page
@model RentalApp.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="login-page min-vh-100 d-flex align-items-center justify-content-center px-3 py-4">
    <div class="login-shell col-12 col-md-9 col-lg-6">
        <div class="text-center mb-3">
            <h1 class="login-brand mb-1">Rental App</h1>
            <p class="login-subtitle mb-0">Reset your password and continue securely.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success">@Model.SuccessMessage</div>
        }

        <form method="post" class="card login-card border-0 shadow-lg">
            <div class="card-body p-4 p-md-5">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Username" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Username" class="form-control form-control-lg login-input" placeholder="Enter username" />
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="Input.FirstName" class="form-control form-control-lg login-input" placeholder="Enter first name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.LastName" class="form-label fw-semibold"></label>
                    <input asp-for="Input.LastName" class="form-control form-control-lg login-input" placeholder="Enter last name" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="Input.NewPassword" class="form-control form-control-lg login-input" placeholder="New password" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg login-input" placeholder="Confirm password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <a asp-page="/Auth/Login" class="login-link small">Back to login</a>
                    <button type="submit" class="btn btn-primary px-4">Update Password</button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .login-page {
        background: radial-gradient(circle at 10% 20%, #e6f0ff 0%, #dce9ff 25%, #f5f8ff 60%, #ffffff 100%);
    }

    .login-shell {
        max-width: 640px;
    }

    .login-brand {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: .5px;
        color: #1b2b59;
    }

    .login-subtitle {
        color: #5c6b8a;
        font-size: .95rem;
    }

    .login-card {
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(6px);
    }

    .login-input {
        border-radius: .65rem;
        border: 1px solid #d8e2f5;
    }

    .login-input:focus {
        border-color: #6f9dff;
        box-shadow: 0 0 0 .2rem rgba(79, 136, 255, 0.2);
    }

    .login-link {
        color: #3559b7;
        text-decoration: none;
    }

    .login-link:hover {
        color: #1f3f93;
        text-decoration: underline;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
