@page
@model RentalApp.Pages.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="page-header-block">
    <h2 class="mb-0">Tenants</h2>
    <a class="btn btn-primary" asp-page="/Tenants/Create">+ Add Tenant</a>
</div>

<form method="get" class="filter-bar row g-2 align-items-end">
    <div class="col-md-6">
        <input asp-for="Search" class="form-control" placeholder="Search by name, contact, or email" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Unit</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PagedItems.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No tenants found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.PagedItems.Items)
                    {
                        <tr>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.ContactNumber</td>
                            <td>@item.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(item.UnitNumber) ? "-" : item.UnitNumber)</td>
                            <td>
                                <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Tenants/Edit" asp-route-id="@item.Id">Edit</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/Tenants/Index",
    PageNumber = Model.PagedItems.PageNumber,
    TotalPages = Model.PagedItems.TotalPages,
    RouteValues = new Dictionary<string, string>
    {
        ["Search"] = Model.Search ?? string.Empty
    }
})" />
