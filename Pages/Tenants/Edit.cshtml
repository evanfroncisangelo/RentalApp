@page "{id:int}"
@model RentalApp.Pages.Tenants.EditModel
@{
    ViewData["Title"] = "Edit Tenant";
}

<div class="page-header-block">
    <h2 class="mb-0">Edit Tenant</h2>
</div>

<form method="post" class="card app-card card-body">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.FirstName" class="form-label"></label>
            <input asp-for="Input.FirstName" class="form-control" />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Input.LastName" class="form-label"></label>
            <input asp-for="Input.LastName" class="form-control" />
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ContactNumber" class="form-label"></label>
        <input asp-for="Input.ContactNumber" class="form-control" />
        <span asp-validation-for="Input.ContactNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Address" class="form-label"></label>
        <input asp-for="Input.Address" class="form-control" />
        <span asp-validation-for="Input.Address" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.MoveInDate" class="form-label"></label>
        <input asp-for="Input.MoveInDate" class="form-control" type="date" />
        <span asp-validation-for="Input.MoveInDate" class="text-danger"></span>
    </div>

    <div class="card card-sm mb-3">
        <div class="card-header bg-light">
            <h6 class="mb-0">Unit Assignment</h6>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Input.UnitId" class="form-label"></label>
                <select asp-for="Input.UnitId" asp-items="Model.UnitOptions" class="form-select">
                    <option value="">Select Unit</option>
                </select>
                <span asp-validation-for="Input.UnitId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-12 mb-0">
                    <label asp-for="Input.IsActive" class="form-label">Status</label>
                    <select asp-for="Input.IsActive" class="form-select">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <div class="form-text">Set tenant status as active or inactive.</div>
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" asp-for="Input.RoomNumber" />

    <div class="d-flex justify-content-end gap-2">
        <a asp-page="/Tenants/Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
