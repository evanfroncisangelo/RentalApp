@page
@model RentalApp.Pages.Tenants.CreateModel
@{
    ViewData["Title"] = "Add Tenant";
}

<div class="page-header-block">
    <h2 class="mb-0">Add Tenant</h2>
</div>

<form method="post" class="card app-card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.FirstName" class="form-label"></label>
            <input asp-for="Input.FirstName" class="form-control" />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Input.LastName" class="form-label"></label>
            <input asp-for="Input.LastName" class="form-control" />
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.ContactNumber" class="form-label"></label>
            <input asp-for="Input.ContactNumber" class="form-control" />
            <span asp-validation-for="Input.ContactNumber" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Address" class="form-label"></label>
        <input asp-for="Input.Address" class="form-control" />
        <span asp-validation-for="Input.Address" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.UnitId" class="form-label"></label>
            <select asp-for="Input.UnitId" asp-items="Model.UnitOptions" class="form-select" id="unitNumberSelect">
                <option value="">Select Unit</option>
            </select>
            <div class="form-text">Only units with available capacity are shown.</div>
            <span asp-validation-for="Input.UnitId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Max Capacity</label>
            <input type="text" class="form-control" id="unitCapacityDisplay" value="@Model.SelectedUnitCapacity" readonly />
            <div class="form-text">Current occupancy / max capacity for selected unit.</div>
        </div>
    </div>

    <input type="hidden" asp-for="Input.RoomNumber" />

    <div class="mb-3">
        <label asp-for="Input.DateOfBirth" class="form-label"></label>
        <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
        <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Notes" class="form-label"></label>
        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.Notes" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-page="/Tenants/Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Tenant</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const unitSelect = document.getElementById('unitNumberSelect');
            const capacityDisplay = document.getElementById('unitCapacityDisplay');
            if (!unitSelect || !capacityDisplay) return;

            function updateCapacityDisplay() {
                const text = unitSelect.options[unitSelect.selectedIndex]?.text || '';
                const match = text.match(/\((\d+\/\d+)\)$/);
                capacityDisplay.value = match ? match[1] : '-';
            }

            unitSelect.addEventListener('change', updateCapacityDisplay);
            updateCapacityDisplay();
        })();
    </script>
}
