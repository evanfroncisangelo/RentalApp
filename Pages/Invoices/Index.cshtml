@page
@model RentalApp.Pages.Invoices.IndexModel
@{
    ViewData["Title"] = "Invoices";
}

<div class="page-header-block">
    <h2 class="mb-0">Invoices</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Invoices/Generate">One-Click Generate</a>
        <a class="btn btn-primary" asp-page="/Invoices/Create">+ Create Invoice</a>
    </div>
</div>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>No.</th>
                <th>Tenant</th>
                <th>Unit</th>
                <th>Date</th>
                <th>Due</th>
                <th>Status</th>
                <th>Total</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedItems.Items.Count == 0)
            {
                <tr>
                    <td colspan="8">
                        <div class="empty-state">
                            <span class="empty-state-title">No invoices found</span>
                            Create an invoice or run one-click generation to get started.
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.PagedItems.Items)
                {
                    <tr>
                        <td>@item.InvoiceNumber</td>
                        <td>@item.TenantName</td>
                        <td>@item.UnitNumber</td>
                        <td>@item.InvoiceDate.ToString("MMM-dd-yyyy")</td>
                        <td>@item.DueDate.ToString("MMM-dd-yyyy")</td>
                        <td>@item.Status</td>
                        <td>@item.Total.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Invoices/Details" asp-route-id="@item.Id">View</a>
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Invoices/Edit" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-dark" asp-page="/Invoices/Print" asp-route-id="@item.Id">Print</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/Invoices/Index",
    PageNumber = Model.PagedItems.PageNumber,
    TotalPages = Model.PagedItems.TotalPages,
    RouteValues = new Dictionary<string, string>()
})" />
