@page
@model RentalApp.Pages.Invoices.GenerateModel
@{
    ViewData["Title"] = "Generate Invoice";
}

<div class="page-header-block">
    <h2 class="mb-0">One-Click Invoice Generation</h2>
</div>

<form method="post" class="card app-card card-body">
    <div class="mb-3">
        <label asp-for="Input.LeaseId" class="form-label"></label>
        <select asp-for="Input.LeaseId" asp-items="Model.LeaseOptions" class="form-select"></select>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Input.InvoiceDate" class="form-label"></label><input asp-for="Input.InvoiceDate" class="form-control" /></div>
        <div class="col-md-6 mb-3"><label asp-for="Input.DueDate" class="form-label"></label><input asp-for="Input.DueDate" class="form-control" /></div>
    </div>

    <div class="mb-3"><label asp-for="Input.Notes" class="form-label"></label><textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea></div>

    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Invoices/Index">Cancel</a>
        <button class="btn btn-primary" type="submit">Generate Invoice</button>
    </div>
</form>
