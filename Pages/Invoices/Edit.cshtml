@page "{id:int}"
@model RentalApp.Pages.Invoices.EditModel
@{
    ViewData["Title"] = "Edit Invoice";
}

<div class="page-header-block">
    <h2 class="mb-0">Edit Invoice @Model.InvoiceNumber</h2>
</div>

<form method="post" class="card app-card card-body">
    <input type="hidden" asp-for="Input.Id" />

    <div class="row">
        <div class="col-md-4 mb-3"><label asp-for="Input.InvoiceDate" class="form-label"></label><input asp-for="Input.InvoiceDate" class="form-control" /></div>
        <div class="col-md-4 mb-3"><label asp-for="Input.DueDate" class="form-label"></label><input asp-for="Input.DueDate" class="form-control" /></div>
        <div class="col-md-4 mb-3"><label asp-for="Input.Status" class="form-label"></label><select asp-for="Input.Status" asp-items="Model.StatusOptions" class="form-select"></select></div>
    </div>

    @for (var i = 0; i < Model.Input.Items.Count; i++)
    {
        <div class="row">
            <div class="col-md-8 mb-3"><label class="form-label">Item Description</label><input asp-for="Input.Items[i].Description" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label class="form-label">Amount</label><input asp-for="Input.Items[i].Amount" class="form-control" /></div>
        </div>
    }

    <div class="mb-3"><label asp-for="Input.Notes" class="form-label"></label><textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea></div>

    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Invoices/Index">Cancel</a>
        <button class="btn btn-primary" type="submit">Save Changes</button>
    </div>
</form>
