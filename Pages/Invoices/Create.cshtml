@page
@model RentalApp.Pages.Invoices.CreateModel
@{
    ViewData["Title"] = "Create Invoice";
}

<div class="page-header-block">
    <h2 class="mb-0">Create Invoice</h2>
</div>

<form method="post" class="card app-card card-body">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.TenantId" class="form-label"></label>
            <select asp-for="Input.TenantId" asp-items="Model.TenantOptions" class="form-select" id="tenantSelect"></select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Connected Lease / Unit</label>
            <input type="text" class="form-control" id="leaseDisplay" readonly value="@Model.SelectedLeaseLabel" />
            <input type="hidden" asp-for="Input.LeaseId" id="leaseIdInput" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3"><label asp-for="Input.InvoiceDate" class="form-label"></label><input asp-for="Input.InvoiceDate" class="form-control" /></div>
        <div class="col-md-4 mb-3"><label asp-for="Input.DueDate" class="form-label"></label><input asp-for="Input.DueDate" class="form-control" /></div>
        <div class="col-md-4 mb-3"><label asp-for="Input.Status" class="form-label"></label><select asp-for="Input.Status" asp-items="Model.StatusOptions" class="form-select"></select></div>
    </div>

    <div class="alert alert-info">
        Invoice items are auto-generated from saved connected records (Rent, Deposit, Utility Bills) for the selected tenant and lease.
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Invoices/Index">Cancel</a>
        <button class="btn btn-primary" type="submit">Save Invoice (PDF)</button>
    </div>
</form>

@section Scripts {
    <script>
        const tenantLeaseMap = @Html.Raw(Model.TenantLeaseMapJson);
        const tenantSelect = document.getElementById('tenantSelect');
        const leaseIdInput = document.getElementById('leaseIdInput');
        const leaseDisplay = document.getElementById('leaseDisplay');

        function resolveLeaseForTenant() {
            const tenantId = Number(tenantSelect?.value || 0);
            const options = tenantLeaseMap[tenantId] || [];

            if (options.length === 0) {
                leaseIdInput.value = '0';
                leaseDisplay.value = 'No active/ended lease found for selected tenant.';
                return;
            }

            const selected = options[0];
            leaseIdInput.value = selected.LeaseId;
            leaseDisplay.value = `Lease #${selected.LeaseId} - Unit ${selected.UnitNumber} (${selected.LeaseStatus})`;
        }

        tenantSelect?.addEventListener('change', resolveLeaseForTenant);
        resolveLeaseForTenant();
    </script>
}
