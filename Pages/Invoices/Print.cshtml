@page "{id:int}"
@model RentalApp.Pages.Invoices.PrintModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.Invoice.InvoiceNumber</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            padding: 24px;
            font-family: Inter, "Segoe UI", Roboto, Arial, sans-serif;
            color: #0f172a;
            background: #ffffff;
        }

        .invoice-box {
            max-width: 820px;
            margin: auto;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px 24px;
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 12px;
            margin-bottom: 16px;
        }

        .invoice-title {
            font-size: 24px;
            font-weight: 700;
            margin: 0;
            color: #0f766e;
        }

        .invoice-subtitle {
            color: #64748b;
            font-size: 13px;
            margin-top: 4px;
        }

        .invoice-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 24px;
            margin-bottom: 16px;
            font-size: 14px;
        }

        .label {
            color: #64748b;
            margin-right: 6px;
        }

        .table {
            margin-bottom: 0;
            border-color: #e2e8f0;
        }

        .table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 13px;
            font-weight: 600;
            border-bottom: 1px solid #e2e8f0;
        }

        .table td,
        .table th {
            padding: 10px 12px;
            border-color: #e2e8f0;
        }

        .total-row th {
            background: #f8fafc;
            font-weight: 700;
        }

        @@media print {
            body {
                padding: 0;
            }

            .invoice-box {
                border: none;
                border-radius: 0;
                padding: 0;
                max-width: none;
            }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="invoice-box">
        <div class="invoice-header">
            <div>
                <h1 class="invoice-title">Rental Invoice</h1>
                <div class="invoice-subtitle">Boarding House Management</div>
            </div>
            <div class="text-end">
                <div><span class="label">Invoice No:</span><strong>@Model.Invoice.InvoiceNumber</strong></div>
            </div>
        </div>

        <div class="invoice-meta">
            <div><span class="label">Tenant:</span>@Model.Invoice.TenantName</div>
            <div><span class="label">Unit:</span>@Model.Invoice.UnitNumber</div>
            <div><span class="label">Invoice Date:</span>@Model.Invoice.InvoiceDate.ToString("yyyy-MM-dd")</div>
            <div><span class="label">Due Date:</span>@Model.Invoice.DueDate.ToString("yyyy-MM-dd")</div>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Invoice.Items)
                {
                    <tr>
                        <td>@item.Description</td>
                        <td class="text-end">@item.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <th class="text-end">Total</th>
                    <th class="text-end">@Model.Invoice.Total.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</body>
</html>
