@page "{id:int}"
@model RentalApp.Pages.Invoices.DetailsModel
@{
    ViewData["Title"] = "Invoice Details";
}

<div class="page-header-block">
    <h2 class="mb-0">Invoice @Model.Invoice.InvoiceNumber</h2>
</div>

<div class="card app-card card-body mb-3">
    <div><strong>Tenant:</strong> @Model.Invoice.TenantName</div>
    <div><strong>Unit:</strong> @Model.Invoice.UnitNumber</div>
    <div><strong>Invoice Date:</strong> @Model.Invoice.InvoiceDate.ToString("yyyy-MM-dd")</div>
    <div><strong>Due Date:</strong> @Model.Invoice.DueDate.ToString("yyyy-MM-dd")</div>
    <div><strong>Status:</strong> @Model.Invoice.Status</div>
    <div><strong>Notes:</strong> @Model.Invoice.Notes</div>
</div>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped mb-0">
    <thead>
        <tr><th>Description</th><th class="text-end">Amount</th></tr>
    </thead>
    <tbody>
        @foreach (var i in Model.Invoice.Items)
        {
            <tr><td>@i.Description</td><td class="text-end">@i.Amount.ToString("N2")</td></tr>
        }
    </tbody>
    <tfoot>
        <tr><th class="text-end">Total</th><th class="text-end">@Model.Invoice.Total.ToString("N2")</th></tr>
    </tfoot>
</table>
    </div>
</div>

<div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" asp-page="/Invoices/Index">Back</a>
    <a class="btn btn-outline-primary" asp-page="/Invoices/Edit" asp-route-id="@Model.Invoice.Id">Edit</a>
    <a class="btn btn-dark" asp-page="/Invoices/Print" asp-route-id="@Model.Invoice.Id">Print</a>
</div>
