@page
@model RentalApp.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "Payments";
}

<div class="page-header-block">
    <h2 class="mb-0">Payments</h2>
    <a class="btn btn-primary" asp-page="/Payments/Create">+ Add Payment</a>
</div>

<div class="card app-card card-body mb-3">
    <div class="table-responsive">
        <table class="table app-grid table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>Date</th>
                <th>Tenant</th>
                <th>Unit</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Reference</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedItems.Items.Count == 0)
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <span class="empty-state-title">No payments yet</span>
                            There are no payment transactions for the current selection.
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.PagedItems.Items)
                {
                    <tr>
                        <td>@item.PaymentDate.ToString("MMM-dd-yyyy")</td>
                        <td>@item.TenantName</td>
                        <td>@item.UnitNumber</td>
                        <td>@item.Amount.ToString("N2")</td>
                        <td>@item.PaymentMethod</td>
                        <td>@item.ReferenceNumber</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/Payments/Index",
    PageNumber = Model.PagedItems.PageNumber,
    TotalPages = Model.PagedItems.TotalPages,
    RouteValues = new Dictionary<string, string>()
})" />
