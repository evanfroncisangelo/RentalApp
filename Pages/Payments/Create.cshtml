@page
@model RentalApp.Pages.Payments.CreateModel
@using System.Text.Json
@{
    ViewData["Title"] = "Add Payment";
}

<div class="page-header-block">
    <h2 class="mb-0">Add Payment</h2>
</div>

<form method="post" class="card app-card card-body">
    <div class="mb-3">
        <label asp-for="Input.LeaseId" class="form-label"></label>
        <select asp-for="Input.LeaseId" asp-items="Model.LeaseOptions" class="form-select" id="leaseSelect"></select>
        <span asp-validation-for="Input.LeaseId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Input.Amount" class="form-label"></label>
            <input asp-for="Input.Amount" class="form-control" id="amountInput" />
            <span asp-validation-for="Input.Amount" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.PaymentDate" class="form-label"></label>
            <input asp-for="Input.PaymentDate" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.PaymentMethod" class="form-label"></label>
            <select asp-for="Input.PaymentMethod" asp-items="Model.PaymentMethodOptions" class="form-select"></select>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ReferenceNumber" class="form-label"></label>
        <input asp-for="Input.ReferenceNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Input.Notes" class="form-label"></label>
        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-page="/Payments/Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Payment</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const leaseRentMap = @Html.Raw(JsonSerializer.Serialize(Model.LeaseRentMap));
        const leaseSelect = document.getElementById('leaseSelect');
        const amountInput = document.getElementById('amountInput');

        function setAmountFromLease() {
            if (!leaseSelect || !amountInput) return;
            const leaseId = leaseSelect.value;
            if (!leaseId) return;

            const rent = leaseRentMap[leaseId];
            if (rent !== undefined && rent !== null) {
                amountInput.value = Number(rent).toFixed(2);
            }
        }

        leaseSelect?.addEventListener('change', setAmountFromLease);
        setAmountFromLease();
    </script>
}
