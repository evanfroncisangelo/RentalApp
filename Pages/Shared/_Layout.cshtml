<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentalApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RentalApp.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        var isDashboard = currentPage.StartsWith("/Dashboard", global::System.StringComparison.OrdinalIgnoreCase);
        var isPayments = currentPage.StartsWith("/ApartmentTenants", global::System.StringComparison.OrdinalIgnoreCase)
                         || currentPage.StartsWith("/Leases", global::System.StringComparison.OrdinalIgnoreCase);
        var isTenants = currentPage.StartsWith("/Tenants", global::System.StringComparison.OrdinalIgnoreCase);
        var isExpenses = currentPage.StartsWith("/Expenses", global::System.StringComparison.OrdinalIgnoreCase)
                         || currentPage.StartsWith("/ExpenseCategories", global::System.StringComparison.OrdinalIgnoreCase);
        var isUtilities = currentPage.StartsWith("/Utilities", global::System.StringComparison.OrdinalIgnoreCase);
        var isInvoices = currentPage.StartsWith("/Invoices", global::System.StringComparison.OrdinalIgnoreCase);

        <div class="app-layout" id="appLayoutRoot">
            <aside class="app-sidebar" id="appSidebar">
                <div class="app-sidebar-header">
                    <a class="app-brand" asp-area="" asp-page="/Dashboard/Index">BOARDING HOUSE</a>
                </div>

                <nav class="app-sidebar-nav">
                    <a class="app-nav-link @(isDashboard ? "active" : null)" asp-page="/Dashboard/Index">Dashboard</a>
                    <a class="app-nav-link @(isPayments ? "active" : null)" asp-page="/ApartmentTenants/Index">Properties & Payments</a>
                    <a class="app-nav-link @(isTenants ? "active" : null)" asp-page="/Tenants/Index">Tenants</a>
                    <a class="app-nav-link @(isExpenses ? "active" : null)" asp-page="/Expenses/Index">Expenses</a>
                    <a class="app-nav-link @(isUtilities ? "active" : null)" asp-page="/Utilities/Index">Utilities</a>
                    <a class="app-nav-link @(isInvoices ? "active" : null)" asp-page="/Invoices/Index">Invoices</a>
                </nav>

                <div class="app-sidebar-footer">
                    <div class="app-user-name">@User.Identity?.Name</div>
                    <form method="post" asp-page="/Auth/Logout" class="d-grid mt-2">
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                </div>
            </aside>

            <div class="app-main">
                <header class="app-topbar">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary app-sidebar-toggle" id="appSidebarToggle" aria-label="Toggle menu">☰</button>
                        <h1 class="app-page-title mb-0">@ViewData["Title"]</h1>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted small d-none d-md-inline">@DateTime.Now.ToString("MMMM yyyy")</span>
                    </div>
                </header>

                <main role="main" class="app-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        var authPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        var useMinimalAuthLayout = authPage.Equals("/Auth/Login", global::System.StringComparison.OrdinalIgnoreCase)
            || authPage.Equals("/Auth/Register", global::System.StringComparison.OrdinalIgnoreCase)
            || authPage.Equals("/Auth/ForgotPassword", global::System.StringComparison.OrdinalIgnoreCase);

        if (!useMinimalAuthLayout)
        {
            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light app-topbar mb-3">
                    <div class="container">
                        <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Dashboard/Index">RentalApp</a>
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-outline-primary btn-sm" asp-page="/Auth/Login">Login</a>
                        </div>
                    </div>
                </nav>
            </header>
        }

        <div class="container app-shell">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.getFriendlyErrorMessage = async function (response, fallbackMessage) {
            const friendlyMessageByExactMatch = {
                "Cannot delete unit with active tenants.": "Cannot delete this unit because it still has active tenants.",
                "Cannot delete property while units exist under it.": "Cannot delete this property because it still has units assigned.",
                "Selected unit is already at maximum capacity.": "This unit is already full. Please choose another unit.",
                "Selected unit does not exist or is inactive.": "The selected unit is no longer available. Please choose another unit.",
                "Selected property does not exist or is inactive.": "The selected property is no longer available. Please refresh and try again."
            };

            let message = "";

            try {
                const contentType = response.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    const json = await response.json();
                    message = (json?.message || json?.Message || '').toString().trim();
                }
                else {
                    message = (await response.text() || '').toString().trim();
                }
            }
            catch {
                message = "";
            }

            if (!message) {
                return fallbackMessage;
            }

            return friendlyMessageByExactMatch[message] || fallbackMessage;
        };

        window.showFriendlyErrorModal = function (message, title) {
            const modalId = 'globalFriendlyErrorModal';
            let modalElement = document.getElementById(modalId);

            if (!modalElement) {
                modalElement = document.createElement('div');
                modalElement.id = modalId;
                modalElement.className = 'modal fade';
                modalElement.tabIndex = -1;
                modalElement.setAttribute('aria-hidden', 'true');
                modalElement.innerHTML = `
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="globalFriendlyErrorModalTitle"></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-0" id="globalFriendlyErrorModalMessage"></p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                            </div>
                        </div>
                    </div>`;

                document.body.appendChild(modalElement);
            }

            const titleElement = document.getElementById('globalFriendlyErrorModalTitle');
            const messageElement = document.getElementById('globalFriendlyErrorModalMessage');

            if (titleElement) {
                titleElement.textContent = title || 'Unable to complete request';
            }

            if (messageElement) {
                messageElement.textContent = message || 'Please try again.';
            }

            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        };

        (function () {
            const toggle = document.getElementById('appSidebarToggle');
            const root = document.getElementById('appLayoutRoot');
            if (toggle && root) {
                toggle.addEventListener('click', function () {
                    root.classList.toggle('sidebar-open');
                });
            }

            async function handleAjaxPagination(url) {
                const appContent = document.querySelector('.app-content');
                if (!appContent) {
                    window.location.href = url;
                    return;
                }

                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    window.location.href = url;
                    return;
                }

                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const nextContent = doc.querySelector('.app-content');

                if (!nextContent) {
                    window.location.href = url;
                    return;
                }

                appContent.innerHTML = nextContent.innerHTML;

                const scripts = Array.from(appContent.querySelectorAll('script'));
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');

                    Array.from(oldScript.attributes).forEach(attr => {
                        newScript.setAttribute(attr.name, attr.value);
                    });

                    if (oldScript.src) {
                        const exists = document.querySelector(`script[src='${oldScript.getAttribute('src')}']`);
                        if (!exists) {
                            document.body.appendChild(newScript);
                        }
                    } else {
                        newScript.text = oldScript.text;
                        document.body.appendChild(newScript);
                    }

                    oldScript.remove();
                });

                window.history.pushState({}, '', url);
            }

            document.addEventListener('click', function (e) {
                const link = e.target.closest('a.js-ajax-pagination');
                if (!link) return;

                const disabled = link.closest('.page-item')?.classList.contains('disabled');
                if (disabled) {
                    e.preventDefault();
                    return;
                }

                const url = link.getAttribute('href');
                if (!url) return;

                e.preventDefault();
                handleAjaxPagination(url).catch(() => {
                    window.location.href = url;
                });
            });

            window.addEventListener('popstate', function () {
                handleAjaxPagination(window.location.href).catch(() => {
                    window.location.reload();
                });
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
