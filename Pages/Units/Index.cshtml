@page
@model RentalApp.Pages.Units.IndexModel
@{
    ViewData["Title"] = "Units";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Units</h2>
    <a class="btn btn-primary" asp-page="/Units/Create">+ Add Unit</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input asp-for="Search" class="form-control" placeholder="Search by property or unit number" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Property</th>
                <th>Unit</th>
                <th>Monthly Rent</th>
                <th>Max Capacity</th>
                <th>Status</th>
                <th>Active</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.PagedItems.Items)
            {
                <tr>
                    <td>@item.PropertyName</td>
                    <td>@item.UnitNumber</td>
                    <td>@item.MonthlyRent.ToString("N2")</td>
                    <td>@item.MaxCapacity</td>
                    <td>@item.Status</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Units/Edit" asp-route-id="@item.Id">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete Unit" onclick="hardDeleteUnit(@item.Id)">X</button>
                        @if (item.IsActive)
                        {
                            <form method="post" asp-page-handler="Deactivate" asp-route-id="@item.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('Deactivate this unit?');">Deactivate</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="@(new RentalApp.Pages.Shared.PaginationModel
{
    PageUrl = "/Units/Index",
    PageNumber = Model.PagedItems.PageNumber,
    TotalPages = Model.PagedItems.TotalPages,
    RouteValues = new Dictionary<string, string>()
})" />

@section Scripts {
    <script>
        window.hardDeleteUnit = async function (unitId) {
            if (!confirm('Permanently delete this unit and all related records?')) {
                return;
            }

            const response = await fetch(`/api/units/${unitId}/hard`, {
                method: 'DELETE'
            });

            if (!response.ok) {
                const friendlyMessage = await window.getFriendlyErrorMessage(response, 'Unable to delete unit right now. Please try again.');
                window.showFriendlyErrorModal(friendlyMessage, 'Delete Unit');
                return;
            }

            window.location.reload();
        }
    </script>
}

