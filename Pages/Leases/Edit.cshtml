@page "{id:int}"
@model RentalApp.Pages.Leases.EditModel
@{
    ViewData["Title"] = "Edit Apartment";
}

<h2 class="mb-3">Edit Apartment</h2>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="card p-3 shadow-sm">
    <input type="hidden" asp-for="Input.Id" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.UnitId" class="form-label"></label>
            <select asp-for="Input.UnitId" asp-items="Model.UnitOptions" class="form-select" id="unitSelect"></select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Input.RoomId" class="form-label"></label>
            <select asp-for="Input.RoomId" asp-items="Model.RoomOptions" class="form-select" id="roomSelect"></select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Input.StartDate" class="form-label"></label>
            <input asp-for="Input.StartDate" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Input.EndDate" class="form-label"></label>
            <input asp-for="Input.EndDate" class="form-control" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Input.MonthlyRent" class="form-label"></label>
            <input asp-for="Input.MonthlyRent" class="form-control" id="monthlyRentInput" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.SecurityDeposit" class="form-label"></label>
            <input asp-for="Input.SecurityDeposit" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.DueDayOfMonth" class="form-label"></label>
            <input asp-for="Input.DueDayOfMonth" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Notes" class="form-label"></label>
        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-page="/Leases/Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('unitSelect')?.addEventListener('change', async function () {
            const unitId = this.value;
            const roomSelect = document.getElementById('roomSelect');
            const monthlyRent = document.getElementById('monthlyRentInput');
            if (!unitId) return;

            const response = await fetch(`/api/leases/unit-info/${unitId}`);
            if (!response.ok) return;

            const data = await response.json();
            monthlyRent.value = data.monthlyRent;

            roomSelect.innerHTML = '';
            (data.rooms || []).forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.roomId;
                opt.text = `${r.roomNumber} (${r.occupiedCount}/${r.maxCapacity})`;
                roomSelect.add(opt);
            });
        });
    </script>
}
