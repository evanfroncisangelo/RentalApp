{
  "DetailedErrors": true,
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RentalAppDb;Trusted_Connection=True;MultipleActiveResultSets=True;Encrypt=False;TrustServerCertificate=True"
  },
  "ApplicationData": {
    "RootPath": "App_Data",
    "UploadsPath": "App_Data/Uploads",
    "BackupsPath": "App_Data/Backups",
    "BackupRetentionDays": 30
  },
  "Jwt": {
    "Issuer": "RentalApp",
    "Audience": "RentalAppClient",
    "Key": "REPLACE_WITH_DEVELOPMENT_JWT_KEY_OR_USER_SECRETS",
    "ExpiresMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

