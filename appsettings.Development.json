{
  "DetailedErrors": true,
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/Rental.db"
  },
  "ApplicationData": {
    "RootPath": "App_Data",
    "DatabasePath": "Data/Rental.db",
    "UploadsPath": "App_Data/Uploads",
    "BackupsPath": "App_Data/Backups"
  },
  "Jwt": {
    "Issuer": "RentalApp",
    "Audience": "RentalAppClient",
    "Key": "REPLACE_WITH_DEVELOPMENT_JWT_KEY_OR_USER_SECRETS",
    "ExpiresMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
